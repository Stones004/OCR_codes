13: )
14: class FileManager:
15:     def __init__(self):
16:         IMAGE_FOLDER.mkdir(parents=True, exist_ok=True)
17:         COMPLETED_FOLDER.mkdir(parents=True, exist_ok=True)
18:         PREVIEW_FOLDER.mkdir(parents=True, exist_ok=True)
19:     def get_next_batch(self):
20:         """
21:         Returns the next batch of images to process.
22:         """
23:         images = sorted([
24:             image
25:             for image in IMAGE_FOLDER.iterdir()
26:             if image.is_file()
27:             and image.suffix.lower() in IMAGE_EXTENSIONS
28:         ])
29:         return images[:BATCH_SIZE]
30:     def move_completed(self, image_path):
31:         """
32:         Move a processed image to the completed folder.
33:         """
34:         destination = COMPLETED_FOLDER / image_path.name
35:         shutil.move(str(image_path), str(destination))
36:     def remaining_images(self):
37:         """
38:         Number of images left.
39:         """
40:         return len([
41:             image
42:             for image in IMAGE_FOLDER.iterdir()
43:             if image.is_file()
44:             and image.suffix.lower() in IMAGE_EXTENSIONS
45:         ])
46:     def completed_images(self):
47:         """
48:         Number of processed images.
49:         """
50:         return len([
51:             image
52:             for image in COMPLETED_FOLDER.iterdir()
53:             if image.is_file()
54:         ])
55:     def create_preview(self, image_path, text):
56:         img = Image.open(image_path).convert("RGB")
57:         draw = ImageDraw.Draw(img)
58:         try:
59:             font = ImageFont.truetype("arial.ttf", 18)
60:         except:
61:             font = ImageFont.load_default()
62:         # Clean OCR text
63:         text = text.replace("\n", " ")
64:         text = " ".join(text.split())
65:         # Limit text length
66:         if len(text) > 80:
67:             text = text[:80] + "..."
68:         # Position at bottom-left
69:         bbox = draw.textbbox((0, 0), text, font=font)
70:         text_height = bbox[3] - bbox[1]
71:         x = 5
72:         y = img.height - text_height - 5
73:         draw.text(
74:             (x, y),
75:             text,
76:             fill=(0, 255, 0),          # Bright Green
77:             font=font,
78:             stroke_width=1,
79:             stroke_fill="black",       # Black outline
80:         )
81:         preview_path = PREVIEW_FOLDER / image_path.name
82:         img.save(preview_path)
