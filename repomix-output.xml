  2: import numpy as np
  3: from PIL import Image
  4: import torch
  5: from transformers import TrOCRProcessor, VisionEncoderDecoderModel
  6: # =====================================================
  7: # Configuration
  8: # =====================================================
  9: IMAGE_PATH = r"D:\OCR_codes\outputs\P1\cropped\page_003.png"
 10: WINDOW_HEIGHT = 96
 11: STRIDE = 32
 12: MIN_INK_PIXELS = 120
 13: MIN_COMPONENT_AREA = 30
 14: PADDING = 10
 15: DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
 16: # =====================================================
 17: # Load TrOCR
 18: # =====================================================
 19: processor = TrOCRProcessor.from_pretrained(
 20:     "microsoft/trocr-base-handwritten"
 21: )
 22: model = VisionEncoderDecoderModel.from_pretrained(
 23:     "microsoft/trocr-base-handwritten"
 24: ).to(DEVICE)
 25: # =====================================================
 26: # Load Image
 27: # =====================================================
 28: img = cv2.imread(IMAGE_PATH)
 29: gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
 30: H, W = gray.shape
 31: print(f"Image Size : {W} x {H}")
 32: window_id = 0
 33: # =====================================================
 34: # Sliding Window
 35: # =====================================================
 36: for y in range(0, H, STRIDE):
 37:     y2 = min(y + WINDOW_HEIGHT, H)
 38:     window = gray[y:y2, :]
 39:     if window.shape[0] < 40:
 40:         continue
 41:     # -----------------------------------------------
 42:     # Threshold
 43:     # -----------------------------------------------
 44:     _, binary = cv2.threshold(
 45:         window,
 46:         0,
 47:         255,
 48:         cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU
 49:     )
 50:     # -----------------------------------------------
 51:     # Ink Density Filter
 52:     # -----------------------------------------------
 53:     ink_pixels = cv2.countNonZero(binary)
 54:     if ink_pixels < MIN_INK_PIXELS:
 55:         continue
 56:     # -----------------------------------------------
 57:     # Connected Components
 58:     # -----------------------------------------------
 59:     num_labels, labels, stats, _ = cv2.connectedComponentsWithStats(binary)
 60:     candidates = []
 61:     for i in range(1, num_labels):
 62:         area = stats[i, cv2.CC_STAT_AREA]
 63:         if area < MIN_COMPONENT_AREA:
 64:             continue
 65:         x = stats[i, cv2.CC_STAT_LEFT]
 66:         yy = stats[i, cv2.CC_STAT_TOP]
 67:         w = stats[i, cv2.CC_STAT_WIDTH]
 68:         h = stats[i, cv2.CC_STAT_HEIGHT]
 69:         candidates.append((area, x, yy, w, h))
 70:     if len(candidates) == 0:
 71:         continue
 72:     # -----------------------------------------------
 73:     # Sort Largest First
 74:     # -----------------------------------------------
 75:     candidates.sort(reverse=True)
 76:     # OCR top 3 blobs
 77:     for blob_id, (_, x, yy, w, h) in enumerate(candidates[:3]):
 78:         x1 = max(0, x - PADDING)
 79:         y1 = max(0, yy - PADDING)
 80:         x2 = min(W, x + w + PADDING)
 81:         y2 = min(window.shape[0], yy + h + PADDING)
 82:         roi = window[y1:y2, x1:x2]
 83:         # Ignore tiny crops
 84:         if roi.shape[0] < 16 or roi.shape[1] < 16:
 85:             continue
 86:         # Upscale
 87:         roi = cv2.resize(
 88:             roi,
 89:             None,
 90:             fx=3,
 91:             fy=3,
 92:             interpolation=cv2.INTER_CUBIC
 93:         )
 94:         # RGB for TrOCR
 95:         pil = Image.fromarray(roi).convert("RGB")
 96:         pixel_values = processor(
 97:             images=pil,
 98:             return_tensors="pt"
 99:         ).pixel_values.to(DEVICE)
100:         generated = model.generate(pixel_values)
101:         text = processor.batch_decode(
102:             generated,
103:             skip_special_tokens=True
104:         )[0].strip()
105:         print("-" * 70)
106:         print(f"Window : {window_id}")
107:         print(f"Global Y : {y}-{y2}")
108:         print(f"Blob : {blob_id}")
109:         print(f"ROI : {roi.shape}")
110:         print(f"Prediction : '{text}'")
111:         cv2.imwrite(
112:             f"window_{window_id:03d}_blob_{blob_id}.png",
113:             roi
114:         )
115:     window_id += 1
