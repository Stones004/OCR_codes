180:             saved += 1
181:     print(
182:         f"  Saved {saved} ROI(s)"
183:     )
184:     if failed:
185:         print(
186:             f"  Failed {failed} page(s)"
187:         )
188: # ============================================================
189: # Main
190: # ============================================================
191: def main():
