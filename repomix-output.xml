  1: '''import cv2
  2: import numpy as np
  3: class Preprocessor:
  4:     def __init__(self, scale=4):
  5:         self.scale = scale
  6:     # --------------------------------------------------
  7:     def upscale(self, img):
  8:         return cv2.resize(
  9:             img,
 10:             None,
 11:             fx=self.scale,
 12:             fy=self.scale,
 13:             interpolation=cv2.INTER_CUBIC
 14:         )
 15:     # --------------------------------------------------
 16:     def otsu(self, img):
 17:         blur = cv2.GaussianBlur(
 18:             img,
 19:             (3,3),
 20:             0   
 21:         )
 22:         _, binary = cv2.threshold(
 23:             blur,
 24:             0,
 25:             255,
 26:             cv2.THRESH_BINARY + cv2.THRESH_OTSU
 27:         )
 28:         return binary
 29:     # --------------------------------------------------
 30:     def morph_close(self, img):
 31:         binary = self.otsu(img)
 32:         kernel = np.ones((2,2), np.uint8)
 33:         return cv2.morphologyEx(
 34:             binary,
 35:             cv2.MORPH_CLOSE,
 36:             kernel
 37:         )
 38:     # --------------------------------------------------
 39:     def morph_dilate(self, img):
 40:         binary = self.otsu(img)
 41:         kernel = np.ones((2,2), np.uint8)
 42:         return cv2.dilate(
 43:             binary,
 44:             kernel,
 45:             iterations=1
 46:         )
 47:     # --------------------------------------------------
 48:     def process(
 49:         self,
 50:         image,
 51:         method="original"
 52:     ):
 53:         if len(image.shape) == 3:
 54:             gray = cv2.cvtColor(
 55:                 image,
 56:                 cv2.COLOR_BGR2GRAY
 57:             )
 58:         else:
 59:             gray = image.copy()
 60:         gray = self.upscale(gray)
 61:         method = method.lower()
 62:         if method == "original":
 63:             return gray
 64:         elif method == "otsu":
 65:             return self.otsu(gray)
 66:         elif method == "morph_close":
 67:             return self.morph_close(gray)
 68:         elif method == "morph_dilate":
 69:             return self.morph_dilate(gray)
 70:         else:
 71:             raise ValueError(
 72:                 f"Unknown preprocessing method: {method}"
 73:             )'''
 74: """
 75: Preprocessor
 76: Converts the cropped annotation region into grayscale and a cleaned
 77: binary image by removing small connected components. The processed
 78: binary image improves annotation detection.
 79: """
 80: import cv2
 81: import numpy as np
 82: class Preprocessor:
 83:     def __init__(self, min_area=200):
 84:         self.min_area = min_area
 85:     # --------------------------------------------------
 86:     def process(self, image):
 87:         if len(image.shape) == 3:
 88:             gray = cv2.cvtColor(
 89:                 image,
 90:                 cv2.COLOR_BGR2GRAY
 91:             )
 92:         else:
 93:             gray = image.copy()
 94:         _, binary = cv2.threshold(
 95:             gray,
 96:             0,
 97:             255,
 98:             cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU
 99:         )
100:         num_labels, labels, stats, _ = cv2.connectedComponentsWithStats(
101:             binary,
102:             connectivity=8
103:         )
104:         clean = np.zeros_like(binary)
105:         for i in range(1, num_labels):
106:             area = stats[i, cv2.CC_STAT_AREA]
107:             if area >= self.min_area:
108:                 clean[labels == i] = 255
109:         return gray, clean
