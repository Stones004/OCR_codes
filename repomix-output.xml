<file path="src/annotation_remover.py">
 1: import cv2
 2: import numpy as np
 3: class AnnotationRemover:
 4:     def __init__(
 5:         self,
 6:         # -------------------------
 7:         # Red HSV
 8:         # -------------------------
 9:         #red_lower1=(0, 20, 20),
10:         #red_lower1 = (0, 80, 40),
11:         red_lower1 = (0, 100, 60),
12:         red_upper1=(15, 255, 255),
13:         #red_lower2=(165, 20, 20),
14:         #red_lower2 = (165, 80, 40),
15:         red_lower2 = (168, 100, 60),
16:         red_upper2=(179, 255, 255),
17:         # -------------------------
18:         # Green HSV
19:         # -------------------------
20:         #green_lower=(30, 20, 20),
21:         #green_lower = (35, 80, 40),
22:         green_lower = (40, 100, 60),
23:         green_upper=(100, 255, 255),
24:         kernel_size=5,
25:         close_iterations=2,
26:         dilate_iterations=2,
27:         use_inpaint=True,
28:         inpaint_radius=5,
29:     ):
30:         self.red_lower1 = np.array(red_lower1, dtype=np.uint8)
31:         self.red_upper1 = np.array(red_upper1, dtype=np.uint8)
32:         self.red_lower2 = np.array(red_lower2, dtype=np.uint8)
33:         self.red_upper2 = np.array(red_upper2, dtype=np.uint8)
34:         self.green_lower = np.array(green_lower, dtype=np.uint8)
35:         self.green_upper = np.array(green_upper, dtype=np.uint8)
36:         self.kernel = np.ones(
37:             (kernel_size, kernel_size),
38:             np.uint8
39:         )
40:         self.close_iterations = close_iterations
41:         self.dilate_iterations = dilate_iterations
42:         self.use_inpaint = use_inpaint
43:         self.inpaint_radius = inpaint_radius
44:     def create_mask(self, image):
45:         hsv = cv2.cvtColor(
46:             image,
47:             cv2.COLOR_BGR2HSV
48:         )
49:         red1 = cv2.inRange(
50:             hsv,
51:             self.red_lower1,
52:             self.red_upper1
53:         )
54:         red2 = cv2.inRange(
55:             hsv,
56:             self.red_lower2,
57:             self.red_upper2
58:         )
59:         red = cv2.bitwise_or(
60:             red1,
61:             red2
62:         )
63:         green = cv2.inRange(
64:             hsv,
65:             self.green_lower,
66:             self.green_upper
67:         )
68:         mask = cv2.bitwise_or(
69:             red,
70:             green
71:         )
72:         mask = cv2.morphologyEx(
73:             mask,
74:             cv2.MORPH_CLOSE,
75:             self.kernel,
76:             iterations=self.close_iterations
77:         )
78:         mask = cv2.dilate(
79:             mask,
80:             self.kernel,
81:             iterations=self.dilate_iterations
82:         )
83:         return mask
84:     def process(self, image):
85:         mask = self.create_mask(image)
86:         cleaned = image.copy()
87:         cleaned[mask > 0] = (255, 255, 255)
88:         return cleaned
89:     def process_debug(self, image):
90:         mask = self.create_mask(image)
91:         cleaned = image.copy()
92:         cleaned[mask > 0] = (255, 255, 255)
93:         return cleaned, mask
