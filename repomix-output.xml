 13: OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
 14: DPI = 300
 15: def pdf_to_images(pdf_path):
 16:     document = fitz.open(pdf_path)
 17:     zoom = DPI / 72
 18:     matrix = fitz.Matrix(zoom, zoom)
 19:     for page_number in range(len(document)):
 20:         page = document.load_page(page_number)
 21:         pix = page.get_pixmap(matrix=matrix)
 22:         image = np.frombuffer(
 23:             pix.samples,
 24:             dtype=np.uint8
 25:         ).reshape(
 26:             pix.height,
 27:             pix.width,
 28:             pix.n
 29:         )
 30:         if pix.n == 4:
 31:             image = cv2.cvtColor(
 32:                 image,
 33:                 cv2.COLOR_RGBA2BGR
 34:             )
 35:         else:
 36:             image = cv2.cvtColor(
 37:                 image,
 38:                 cv2.COLOR_RGB2BGR
 39:             )
 40:         yield page_number + 1, image
 41:     document.close()
 42: class Preprocessor:
 43:     def __init__(self, kernel_size=3):
 44:         self.kernel_size = kernel_size
 45:     def full_pipeline(self, gray):
 46:         _, binary = cv2.threshold(
 47:             gray,
 48:             0,
 49:             255,
 50:             cv2.THRESH_BINARY + cv2.THRESH_OTSU
 51:         )
 52:         kernel = np.ones(
 53:             (
 54:                 self.kernel_size,
 55:                 self.kernel_size
 56:             ),
 57:             np.uint8
 58:         )
 59:         return cv2.morphologyEx(
 60:             binary,
 61:             cv2.MORPH_CLOSE,
 62:             kernel
 63:         )
 64:     def process(self, image):
 65:         gray = cv2.cvtColor(
 66:             image,
 67:             cv2.COLOR_BGR2GRAY
 68:         )
 69:         return self.full_pipeline(gray)
 70: def process_page(image):
 71:     deskewed, angle = deskewer.process(image)
 72:     vertical, _ = vertical_extractor.extract(deskewed)
 73:     _, separator = line_detector.detect(vertical)
 74:     if separator is None:
 75:         return []
 76:     strip = cropper.crop(deskewed, separator)
 77:     if strip is None:
 78:         return []
 79:     gray = cv2.cvtColor(
 80:         strip,
 81:         cv2.COLOR_BGR2GRAY
 82:     )
 83:     _, binary = cv2.threshold(
 84:         gray,
 85:         0,
 86:         255,
 87:         cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU
 88:     )
 89:     rois, _ = annotation_detector.detect(
 90:         gray,
 91:         binary
 92:     )
 93:     print(type(rois))
 94:     print(len(rois))
 95:     return rois
 96: def process_pdf(pdf_path):
 97:     pdf_name = pdf_path.stem
 98:     print(f"\nProcessing {pdf_name}")
 99:     saved = 0
100:     failed = 0
101:     for page_number, image in pdf_to_images(pdf_path):
102:         try:
103:             rois = process_page(image)
104:         except Exception as e:
105:             print(
106:                 f"Page {page_number:03d} failed : {e}"
107:             )
108:             failed += 1
109:             continue
110:         if len(rois) == 0:
111:             print(
112:                 f"Page {page_number:03d}: No annotations detected"
113:             )
114:             failed += 1
115:             continue
116:         for roi_number, roi in enumerate(rois, start=1):
117:             filename = (
118:                 f"{pdf_name}"
119:                 f"_page_{page_number:03d}"
120:                 f"_roi_{roi_number:03d}.png"
121:             )
122:             output_path = OUTPUT_DIR / filename
123:             cv2.imwrite(
124:                 str(output_path),
125:                 roi["roi"]
126:             )
127:             saved += 1
128:     print(
129:         f"  Saved {saved} ROI(s)"
130:     )
131:     if failed:
132:         print(
133:             f"  Failed {failed} page(s)"
134:         )
