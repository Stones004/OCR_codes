<file path="src/line_detector.py">
  1: import cv2
  2: import numpy as np
  3: """
  4: Separator Detector
  5: Identifies the vertical separator line from the extracted vertical
  6: structures using connected component analysis and geometric filtering.
  7: The detected separator is later used to isolate the annotation margin.
  8: """
  9: class LineDetector:
 10:     def __init__(
 11:         self,
 12:         left_ratio=0.05,
 13:         right_ratio=0.50,
 14:         expected_x=None,
 15:         tolerance=None
 16:     ):
 17:         """
 18:         Parameters
 19:         ----------
 20:         left_ratio : float
 21:             Ignore detections too close to the left page border.
 22:         right_ratio : float
 23:             Ignore detections beyond this percentage of the page width.
 24:         expected_x : int | None
 25:             Expected x-coordinate of the separator.
 26:         tolerance : int | None
 27:             Allowed deviation from expected_x.
 28:         """
 29:         self.left_ratio = left_ratio
 30:         self.right_ratio = right_ratio
 31:         self.expected_x = expected_x
 32:         self.tolerance = tolerance
 33:     def detect(self, vertical):
 34:         num_labels, labels, stats, centroids = cv2.connectedComponentsWithStats(
 35:             vertical,
 36:             connectivity=8
 37:         )
 38:         h, w = vertical.shape
 39:         LEFT_LIMIT = int(w * self.left_ratio)
 40:         RIGHT_LIMIT = int(w * self.right_ratio)
 41:         output = cv2.cvtColor(vertical, cv2.COLOR_GRAY2BGR)
 42:         candidates = []
 43:         for i in range(1, num_labels):
 44:             x = stats[i, cv2.CC_STAT_LEFT]
 45:             y = stats[i, cv2.CC_STAT_TOP]
 46:             width = stats[i, cv2.CC_STAT_WIDTH]
 47:             height = stats[i, cv2.CC_STAT_HEIGHT]
 48:             area = stats[i, cv2.CC_STAT_AREA]
 49:             # -----------------------------
 50:             # Basic geometric filtering
 51:             # -----------------------------
 52:             reason = None
 53:             if height < h * 0.50:
 54:                 reason = f"Too short ({height}px)"
 55:             elif ( height / width) < 40:
 56:                 reason = f"Poor aspect ratio ({(height / width):.1f})"
 57:             elif x < LEFT_LIMIT:
 58:                 reason = f"Too close to left border (x={x})"
 59:             elif x > RIGHT_LIMIT:
 60:                 reason = f"Outside left half (x={x})"
 61:             if reason is not None:
 62:                 print(
 63:                     f"Rejected Component {i} | "
 64:                     f"x={x}, y={y}, w={width}, h={height} | "
 65:                     f"Reason: {reason}"
 66:                 )
 67:                 continue
 68:             component_mask = np.zeros_like(vertical)
 69:             component_mask[labels == i] = 255
 70:             points = np.column_stack(np.where(component_mask > 0))
 71:             candidate = {
 72:                 "x": x,
 73:                 "y": y,
 74:                 "w": width,
 75:                 "h": height,
 76:                 "area": area,
 77:                 "mask": component_mask,
 78:                 "points": points
 79:             }
 80:             candidates.append(candidate)
 81:             # Draw every valid candidate
 82:             cv2.rectangle(
 83:                 output,
 84:                 (x, y),
 85:                 (x + width, y + height),
 86:                 (0, 255, 0),
 87:                 2
 88:             )
 89:             print("\nValid Candidates")
 90:             for c in candidates:
 91:                 print(
 92:                     f"x={c['x']}, "
 93:                     f"h={c['h']}, "
 94:                     f"w={c['w']}, "
 95:                     f"area={c['area']}"
 96:                 )
 97:         # ------------------------------------------------
 98:         # No candidates
 99:         # ------------------------------------------------
100:         if len(candidates) == 0:
101:             return output, None
102:         # ------------------------------------------------
103:         # If we know approximately where the separator is,
104:         # choose the closest candidate.
105:         # ------------------------------------------------
106:         if self.expected_x is not None:
107:             if self.tolerance is not None:
108:                 filtered = []
109:                 for c in candidates:
110:                     if abs(c["x"] - self.expected_x) <= self.tolerance:
111:                         filtered.append(c)
112:                 if len(filtered) > 0:
113:                     candidates = filtered
114:             best = min(
115:                 candidates,
116:                 key=lambda c: abs(c["x"] - self.expected_x)
117:             )
118:         else:
119:             # First run:
120:             # choose the left-most candidate.
121:             best = min(
122:                 candidates,
123:                 key=lambda c: c["x"]
124:             )
125:         # Draw best candidate in RED
126:         cv2.rectangle(
127:             output,
128:             (best["x"], best["y"]),
129:             (best["x"] + best["w"], best["y"] + best["h"]),
130:             (0, 0, 255),
131:             4
132:         )
133:         print("\nSelected Candidate")
134:         print(best)
135:         return output, best
