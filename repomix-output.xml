<file path="src/deskewer.py">
 1: import cv2
 2: import numpy as np
 3: """
 4: Deskewer
 5: Automatically estimates the skew angle of scanned pages using
 6: projection profile analysis and rotates the image to improve
 7: alignment for downstream processing.
 8: """
 9: class Deskewer:
10:     def __init__(
11:         self,
12:         angle_range=(-5.0, 5.0),
13:         coarse_step=0.5,
14:         fine_step=0.05
15:     ):
16:         self.angle_range = angle_range
17:         self.coarse_step = coarse_step
18:         self.fine_step = fine_step
19:     # --------------------------------------------------
20:     # Horizontal Projection Score
21:     # --------------------------------------------------
22:     @staticmethod
23:     def projection_score(binary):
24:         projection = np.sum(binary == 255, axis=1)
25:         return np.var(projection)
26:     # --------------------------------------------------
27:     # Rotate image
28:     # --------------------------------------------------
29:     @staticmethod
30:     def rotate(image, angle):
31:         h, w = image.shape[:2]
32:         center = (w // 2, h // 2)
33:         M = cv2.getRotationMatrix2D(
34:             center,
35:             angle,
36:             1.0
37:         )
38:         rotated = cv2.warpAffine(
39:             image,
40:             M,
41:             (w, h),
42:             flags=cv2.INTER_LINEAR,
43:             borderMode=cv2.BORDER_CONSTANT,
44:             borderValue=255
45:         )
46:         return rotated
47:     # --------------------------------------------------
48:     # Find Best Angle
49:     # --------------------------------------------------
50:     def find_best_angle(self, binary):
51:         best_angle = 0
52:         best_score = -1
53:         # ------------------------
54:         # Coarse Search
55:         # ------------------------
56:         for angle in np.arange(
57:             self.angle_range[0],
58:             self.angle_range[1] + self.coarse_step,
59:             self.coarse_step
60:         ):
61:             rotated = self.rotate(binary, angle)
62:             score = self.projection_score(rotated)
63:             if score > best_score:
64:                 best_score = score
65:                 best_angle = angle
66:         # ------------------------
67:         # Fine Search
68:         # ------------------------
69:         fine_start = best_angle - 0.5
70:         fine_end = best_angle + 0.5
71:         best_score = -1
72:         for angle in np.arange(
73:             fine_start,
74:             fine_end + self.fine_step,
75:             self.fine_step
76:         ):
77:             rotated = self.rotate(binary, angle)
78:             score = self.projection_score(rotated)
79:             if score > best_score:
80:                 best_score = score
81:                 best_angle = angle
82:         return best_angle
83:     # --------------------------------------------------
84:     # Deskew
85:     # --------------------------------------------------
86:     def process(self, image):
87:         gray = cv2.cvtColor(
88:             image,
89:             cv2.COLOR_BGR2GRAY
90:         )
91:         _, binary = cv2.threshold(
92:             gray,
93:             0,
94:             255,
95:             cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU
96:         )
97:         angle = self.find_best_angle(binary)
98:         corrected = self.rotate(image, angle)
99:         return corrected, angle
