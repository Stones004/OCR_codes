<file path="src/cropper.py">
 1: import cv2
 2: """
 3: Margin Cropper
 4: Crops the page using the detected separator so that only the left
 5: annotation region is retained for subsequent annotation detection
 6: and OCR.
 7: """
 8: class Cropper:
 9:     def __init__(self, right_padding=15):
10:         """
11:         right_padding :
12:             Number of pixels to include AFTER the separator.
13:         """
14:         self.right_padding = right_padding
15:     def crop(self, image, separator):
16:         if separator is None:
17:             return None
18:         x = separator["x"] + self.right_padding
19:         # Prevent overflow
20:         x = min(x, image.shape[1])
21:         cropped = image[:, :x]
22:         return cropped
