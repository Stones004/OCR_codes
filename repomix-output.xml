 1: import cv2
 2: import numpy as np
 3: class AnnotationRemover:
 4:     def __init__(
 5:         self,
 6:         red_lower1 = (0, 100, 60),
 7:         red_upper1=(15, 255, 255),
 8:         red_lower2 = (168, 100, 60),
 9:         red_upper2=(179, 255, 255),
10:         green_lower = (40, 100, 60),
11:         green_upper=(100, 255, 255),
12:         kernel_size=5,
13:         close_iterations=2,
14:         dilate_iterations=2,
15:         use_inpaint=True,
16:         inpaint_radius=5,
17:     ):
18:         self.red_lower1 = np.array(red_lower1, dtype=np.uint8)
19:         self.red_upper1 = np.array(red_upper1, dtype=np.uint8)
20:         self.red_lower2 = np.array(red_lower2, dtype=np.uint8)
21:         self.red_upper2 = np.array(red_upper2, dtype=np.uint8)
22:         self.green_lower = np.array(green_lower, dtype=np.uint8)
23:         self.green_upper = np.array(green_upper, dtype=np.uint8)
24:         self.kernel = np.ones(
25:             (kernel_size, kernel_size),
26:             np.uint8
27:         )
28:         self.close_iterations = close_iterations
29:         self.dilate_iterations = dilate_iterations
30:         self.use_inpaint = use_inpaint
31:         self.inpaint_radius = inpaint_radius
32:     def create_mask(self, image):
33:         hsv = cv2.cvtColor(
34:             image,
35:             cv2.COLOR_BGR2HSV
36:         )
37:         red1 = cv2.inRange(
38:             hsv,
39:             self.red_lower1,
40:             self.red_upper1
41:         )
42:         red2 = cv2.inRange(
43:             hsv,
44:             self.red_lower2,
45:             self.red_upper2
46:         )
47:         red = cv2.bitwise_or(
48:             red1,
49:             red2
50:         )
51:         green = cv2.inRange(
52:             hsv,
53:             self.green_lower,
54:             self.green_upper
55:         )
56:         mask = cv2.bitwise_or(
57:             red,
58:             green
59:         )
60:         mask = cv2.morphologyEx(
61:             mask,
62:             cv2.MORPH_CLOSE,
63:             self.kernel,
64:             iterations=self.close_iterations
65:         )
66:         mask = cv2.dilate(
67:             mask,
68:             self.kernel,
69:             iterations=self.dilate_iterations
70:         )
71:         return mask
72:     def process(self, image):
73:         mask = self.create_mask(image)
74:         cleaned = image.copy()
75:         cleaned[mask > 0] = (255, 255, 255)
76:         return cleaned
77:     def process_debug(self, image):
78:         mask = self.create_mask(image)
79:         cleaned = image.copy()
80:         cleaned[mask > 0] = (255, 255, 255)
81:         return cleaned, mask
