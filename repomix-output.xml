  1: import cv2
  2: import numpy as np
  3: # -----------------------------
  4: # Configuration
  5: # -----------------------------
  6: IMAGE_PATH = r"D:\OCR_codes\outputs\P5 (1)\roi\page_008.png"         # Your image
  7: Y_THRESHOLD = 20                   # Max Y difference to belong to same line
  8: MIN_CONTOUR_AREA = 10              # Ignore tiny noise
  9: PADDING = 10
 10: # -----------------------------
 11: # Load image
 12: # ----------------------------- 
 13: img = cv2.imread(IMAGE_PATH)
 14: output = img.copy()
 15: gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
 16: # -----------------------------
 17: # Threshold
 18: # -----------------------------
 19: _, binary = cv2.threshold(
 20:     gray,
 21:     0,
 22:     255,
 23:     cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU
 24: )
 25: # -----------------------------
 26: # Find contours
 27: # -----------------------------
 28: contours, _ = cv2.findContours(
 29:     binary,
 30:     cv2.RETR_EXTERNAL,
 31:     cv2.CHAIN_APPROX_SIMPLE
 32: )
 33: # -----------------------------
 34: # Store contour information
 35: # -----------------------------
 36: boxes = []
 37: for cnt in contours:
 38:     area = cv2.contourArea(cnt)
 39:     if area < 40:
 40:         continue
 41:     x, y, w, h = cv2.boundingRect(cnt)
 42:     # Remove tiny dots
 43:     if w < 4 or h < 4:
 44:         continue
 45:     # Remove extremely thin vertical lines
 46:     if h > 80 and w < 4:
 47:         continue
 48:     # Remove extremely thin horizontal lines
 49:     if w > 80 and h < 4:
 50:         continue
 51:     # Remove contours touching image borders
 52:     margin = 2
 53:     if (
 54:         x <= margin or
 55:         y <= margin or
 56:         x + w >= img.shape[1] - margin or
 57:         y + h >= img.shape[0] - margin
 58:     ):
 59:         continue
 60:     cy = y + h // 2
 61:     x, y, w, h = cv2.boundingRect(cnt)
 62:     cy = y + h // 2
 63:     boxes.append({
 64:         "x": x,
 65:         "y": y,
 66:         "w": w,
 67:         "h": h,
 68:         "cy": cy
 69:     })
 70: # -----------------------------
 71: # Sort by Y coordinate
 72: # -----------------------------
 73: boxes.sort(key=lambda b: b["cy"])
 74: # -----------------------------
 75: # Group boxes having similar Y
 76: # -----------------------------
 77: groups = []
 78: for box in boxes:
 79:     assigned = False
 80:     for group in groups:
 81:         if abs(box["cy"] - group["cy"]) < Y_THRESHOLD:
 82:             group["boxes"].append(box)
 83:             ys = [b["cy"] for b in group["boxes"]]
 84:             group["cy"] = np.mean(ys)
 85:             assigned = True
 86:             break
 87:     if not assigned:
 88:         groups.append({
 89:             "cy": box["cy"],
 90:             "boxes": [box]
 91:         })
 92: # -----------------------------
 93: # Merge boxes inside each group
 94: # -----------------------------
 95: for group in groups:
 96:     xs = []
 97:     ys = []
 98:     xe = []
 99:     ye = []
100:     for b in group["boxes"]:
101:         xs.append(b["x"])
102:         ys.append(b["y"])
103:         xe.append(b["x"] + b["w"])
104:         ye.append(b["y"] + b["h"])
105:     x1 = max(0, min(xs) - PADDING)
106:     y1 = max(0, min(ys) - PADDING)
107:     x2 = min(img.shape[1], max(xe) + PADDING)
108:     y2 = min(img.shape[0], max(ye) + PADDING)
109:     cv2.rectangle(
110:         output,
111:         (x1, y1),
112:         (x2, y2),
113:         (0, 255, 0),
114:         2
115:     )
116: # -----------------------------
117: # Save
118: # -----------------------------
119: cv2.imwrite("detected_lines.png", output)
120: print("Done.")
