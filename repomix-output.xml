26:     x, y, w, h = cv2.boundingRect(cnt)
27:     if w < 4 or h < 4:
28:         continue
29:     if h > 80 and w < 4:
30:         continue
31:     if w > 80 and h < 4:
32:         continue
33:     margin = 2
34:     if (
35:         x <= margin or
36:         y <= margin or
37:         x + w >= img.shape[1] - margin or
38:         y + h >= img.shape[0] - margin
39:     ):
40:         continue
41:     cy = y + h // 2
42:     x, y, w, h = cv2.boundingRect(cnt)
43:     cy = y + h // 2
44:     boxes.append({
45:         "x": x,
46:         "y": y,
47:         "w": w,
48:         "h": h,
49:         "cy": cy
50:     })
51: boxes.sort(key=lambda b: b["cy"])
52: groups = []
53: for box in boxes:
54:     assigned = False
55:     for group in groups:
56:         if abs(box["cy"] - group["cy"]) < Y_THRESHOLD:
57:             group["boxes"].append(box)
58:             ys = [b["cy"] for b in group["boxes"]]
59:             group["cy"] = np.mean(ys)
60:             assigned = True
