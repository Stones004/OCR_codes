  2: import numpy as np
  3: from PIL import Image
  4: import torch
  5: from transformers import TrOCRProcessor, VisionEncoderDecoderModel
  6: IMAGE_PATH = r"D:\OCR_codes\outputs\P1\cropped\page_003.png"
  7: WINDOW_HEIGHT = 96
  8: STRIDE = 32
  9: MIN_INK_PIXELS = 120
 10: MIN_COMPONENT_AREA = 30
 11: PADDING = 10
 12: DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
 13: processor = TrOCRProcessor.from_pretrained(
 14:     "microsoft/trocr-base-handwritten"
 15: )
 16: model = VisionEncoderDecoderModel.from_pretrained(
 17:     "microsoft/trocr-base-handwritten"
 18: ).to(DEVICE)
 19: img = cv2.imread(IMAGE_PATH)
 20: gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
 21: H, W = gray.shape
 22: print(f"Image Size : {W} x {H}")
 23: window_id = 0
 24: # =====================================================
 25: # Sliding Window
 26: # =====================================================
 27: for y in range(0, H, STRIDE):
 28:     y2 = min(y + WINDOW_HEIGHT, H)
 29:     window = gray[y:y2, :]
 30:     if window.shape[0] < 40:
 31:         continue
 32:     # -----------------------------------------------
 33:     # Threshold
 34:     # -----------------------------------------------
 35:     _, binary = cv2.threshold(
 36:         window,
 37:         0,
 38:         255,
 39:         cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU
 40:     )
 41:     # -----------------------------------------------
 42:     # Ink Density Filter
 43:     # -----------------------------------------------
 44:     ink_pixels = cv2.countNonZero(binary)
 45:     if ink_pixels < MIN_INK_PIXELS:
 46:         continue
 47:     # -----------------------------------------------
 48:     # Connected Components
 49:     # -----------------------------------------------
 50:     num_labels, labels, stats, _ = cv2.connectedComponentsWithStats(binary)
 51:     candidates = []
 52:     for i in range(1, num_labels):
 53:         area = stats[i, cv2.CC_STAT_AREA]
 54:         if area < MIN_COMPONENT_AREA:
 55:             continue
 56:         x = stats[i, cv2.CC_STAT_LEFT]
 57:         yy = stats[i, cv2.CC_STAT_TOP]
 58:         w = stats[i, cv2.CC_STAT_WIDTH]
 59:         h = stats[i, cv2.CC_STAT_HEIGHT]
 60:         candidates.append((area, x, yy, w, h))
 61:     if len(candidates) == 0:
 62:         continue
 63:     # -----------------------------------------------
 64:     # Sort Largest First
 65:     # -----------------------------------------------
 66:     candidates.sort(reverse=True)
 67:     # OCR top 3 blobs
 68:     for blob_id, (_, x, yy, w, h) in enumerate(candidates[:3]):
 69:         x1 = max(0, x - PADDING)
 70:         y1 = max(0, yy - PADDING)
 71:         x2 = min(W, x + w + PADDING)
 72:         y2 = min(window.shape[0], yy + h + PADDING)
 73:         roi = window[y1:y2, x1:x2]
 74:         # Ignore tiny crops
 75:         if roi.shape[0] < 16 or roi.shape[1] < 16:
 76:             continue
