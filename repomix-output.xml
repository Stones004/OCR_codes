 97: content = re.sub(r"^```json\s*", "", content.strip())
 98: content = re.sub(r"^```\s*", "", content)
 99: content = re.sub(r"\s*```$", "", content)
100: try:
101:     results = json.loads(content)
102: except Exception as e:
103:     print("\nCould not parse JSON.")
104:     print(e)
105:     raise
106: # ============================
107: # Draw Results
108: # ============================
109: image = Image.open(IMAGE_PATH).convert("RGB")
110: draw = ImageDraw.Draw(image)
111: orig_w, orig_h = image.size
112: # -----------------------------
113: # Calibration (pixels)
114: # -----------------------------
115: X_OFFSET = 25      # positive -> move right
116: Y_OFFSET = 0       # positive -> move down
117: X_SCALE = 1.00     # stretch horizontally
118: Y_SCALE = 1.00     # stretch vertically
119: print(f"Original image : {orig_w} x {orig_h}")
120: # ----------------------------------------
121: # Change this to True to test swapped x/y
122: # ----------------------------------------
123: SWAP_XY = False
124: try:
125:     font = ImageFont.truetype("arial.ttf", 18)
