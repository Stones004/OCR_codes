<file path="src/ocr_preprocessor.py">
  1: """
  2: OCR Preprocessor
  3: Prepares cropped annotation margins for OCR.
  4: Every preprocessing algorithm should be implemented as an
  5: independent method so that they can be benchmarked easily.
  6: """
  7: import cv2
  8: import numpy as np
  9: from pathlib import Path
 10: class OCRPreprocessor:
 11:     def __init__(
 12:         self,
 13:         method="connected_components",
 14:         scale=4,
 15:         # Connected Components
 16:         min_area=200,
 17:         # Bilateral
 18:         bilateral_d=9,
 19:         bilateral_sigma_color=75,
 20:         bilateral_sigma_space=75,
 21:         # Morphology
 22:         kernel_size=2,
 23:         iterations=1,
 24:         # Gamma
 25:         gamma=2.0,
 26:         # Rolling Ball
 27:         rolling_radius=80
 28:     ):
 29:         self.method = method.lower()
 30:         self.scale = scale
 31:         self.min_area = min_area
 32:         self.bilateral_d = bilateral_d
 33:         self.bilateral_sigma_color = bilateral_sigma_color
 34:         self.bilateral_sigma_space = bilateral_sigma_space
 35:         self.kernel_size = kernel_size
 36:         self.iterations = iterations
 37:         self.gamma_value = gamma
 38:         self.rolling_radius = rolling_radius
 39:         self.methods = {
 40:             "connected_components": self.connected_components,
 41:             "otsu": self.otsu,
 42:             "morph_close": self.morph_close,
 43:             "morph_dilate": self.morph_dilate,
 44:             "bilateral_otsu": self.bilateral_otsu,
 45:             "full_pipeline": self.full_pipeline,
 46:         }
 47:         print("\nRegistered preprocessing methods:")
 48:         for name, fn in self.methods.items():
 49:             print(f"{name:25} -> {type(fn)}")
 50:     # --------------------------------------------------
 51:     # Utilities
 52:     # --------------------------------------------------
 53:     def to_gray(self, image):
 54:         if len(image.shape) == 3:
 55:             return cv2.cvtColor(
 56:                 image,
 57:                 cv2.COLOR_BGR2GRAY
 58:             )
 59:         return image.copy()
 60:     def upscale(self, gray):
 61:         return cv2.resize(
 62:             gray,
 63:             None,
 64:             fx=self.scale,
 65:             fy=self.scale,
 66:             interpolation=cv2.INTER_CUBIC
 67:         )
 68:     def connected_components(self, gray):
 69:         _, binary = cv2.threshold(
 70:             gray,
 71:             0,
 72:             255,
 73:             cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU
 74:         )
 75:         num_labels, labels, stats, _ = cv2.connectedComponentsWithStats(
 76:             binary,
 77:             connectivity=8
 78:         )
 79:         clean = np.zeros_like(binary)
 80:         for i in range(1, num_labels):
 81:             area = stats[i, cv2.CC_STAT_AREA]
 82:             if area >= self.min_area:
 83:                 clean[labels == i] = 255
 84:         return clean
 85:     def otsu(self, gray):
 86:         denoised = cv2.fastNlMeansDenoising(
 87:             gray,
 88:             h=10
 89:         )
 90:         _, binary = cv2.threshold(
 91:             denoised,
 92:             0,
 93:             255,
 94:             cv2.THRESH_BINARY + cv2.THRESH_OTSU
 95:         )
 96:         return binary
 97:     def morph_close(self, gray):
 98:         _, binary = cv2.threshold(
 99:             gray,
100:             0,
101:             255,
102:             cv2.THRESH_BINARY + cv2.THRESH_OTSU
103:     )
104:         kernel = np.ones(
105:             (
106:                 self.kernel_size,
107:                 self.kernel_size
108:             ),
109:             np.uint8
110:         )
111:         return cv2.morphologyEx(
112:             binary,
113:             cv2.MORPH_CLOSE,
114:             kernel
115:         )
116:     def morph_dilate(self, gray):
117:         _, binary = cv2.threshold(
118:             gray,
119:             0,
120:             255,
121:             cv2.THRESH_BINARY + cv2.THRESH_OTSU
122:         )
123:         kernel = np.ones(
124:             (
125:                 self.kernel_size,
126:                 self.kernel_size
127:             ),
128:             np.uint8
129:         )
130:         return cv2.dilate(
131:             binary,
132:             kernel,
133:             iterations=self.iterations
134:         )
135:     def bilateral_otsu(self, gray):
136:         _, binary = cv2.threshold(
137:             gray,
138:             0,
139:             255,
140:             cv2.THRESH_BINARY + cv2.THRESH_OTSU
141:         )
142:         return binary
143:     def full_pipeline(self, gray):
144:         _, binary = cv2.threshold(
145:             gray,
146:             0,
147:             255,
148:             cv2.THRESH_BINARY + cv2.THRESH_OTSU
149:         )
150:         kernel = np.ones(
151:             (
152:                 self.kernel_size,
153:                 self.kernel_size
154:             ),
155:             np.uint8
156:         )
157:         return cv2.morphologyEx(
158:             binary,
159:             cv2.MORPH_CLOSE,
160:             kernel
161:         )
162:     # --------------------------------------------------
163:     # Main Interface
164:     # --------------------------------------------------
165:     def process(self, image):
166:         gray = self.to_gray(image)
167:         gray = self.upscale(gray)
168:         if self.method not in self.methods:
169:             raise ValueError(
170:                 f"Unknown preprocessing method: {self.method}"
171:             )
172:         processed = self.methods[self.method](gray)
173:         return gray, processed
174:     def available_methods(self):
175:         """Return all registered preprocessing methods."""
176:         return list(self.methods.keys())
177:     def process_method(self, image, method):
178:         """
179:         Process an image using a specific preprocessing method.
180:         """
181:         if method not in self.methods:
182:             raise ValueError(f"Unknown preprocessing method: {method}")
183:         gray = self.to_gray(image)
184:         gray = self.upscale(gray)
185:         processed = self.methods[method](gray.copy())
186:         return gray, processed
187:     def benchmark(self, image):
188:         """
189:         Run every preprocessing method on the same image.
190:         """
191:         gray = self.to_gray(image)
192:         gray = self.upscale(gray)
193:         outputs = {}
194:         for method in self.available_methods():
195:             outputs[method] = self.methods[method](gray.copy())
196:         return gray, outputs
197:     def save_benchmark(self, outputs, output_dir):
198:         """
199:         Save all benchmark images.
200:         """
201:         output_dir = Path(output_dir)
202:         output_dir.mkdir(parents=True, exist_ok=True)
203:         for name, image in outputs.items():
204:             cv2.imwrite(
205:                 str(output_dir / f"{name}.png"),
206:                 image
207:             )
</file>

