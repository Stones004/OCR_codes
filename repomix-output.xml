<file path="src/roi_text_extractor.py">
 1: """
 2: ROI Text Extractor
 3: Provides a unified interface for OCR extraction.
 4: If ROIs are supplied, OCR is performed on each ROI.
 5: Otherwise, OCR is performed on the entire image.
 6: The output is normalized into a common format so that the
 7: rest of the pipeline remains independent of the OCR backend.
 8: """
 9: from src.config import PipelineConfig
10: from src.ocr import create_backend
11: class ROITextExtractor:
12:     def __init__(self, backend=None, use_backend_preprocessing=True):
13:         backend = backend or PipelineConfig.OCR_BACKEND
14:         self.ocr = create_backend(backend)
15:         self.use_backend_preprocessing = use_backend_preprocessing
16:     # --------------------------------------------------
17:     def extract(self, image, rois=None):
18:         predictions = []
19:         # --------------------------------------------------
20:         # Whole-image OCR
21:         # --------------------------------------------------
22:         if rois is None:
23:             result = self.ocr.read(
24:                 image,
25:                 preprocess=self.use_backend_preprocessing
26:             )
27:             if isinstance(result, list):
28:                 predictions.extend(result)
29:             else:
30:                 predictions.append(result)
31:         # --------------------------------------------------
32:         # ROI OCR
33:         # --------------------------------------------------
34:         else:
35:             for roi in rois:
36:                 result = self.ocr.read(roi["roi"])
37:                 if isinstance(result, list):
38:                     predictions.extend(result)
39:                 else:
40:                     predictions.append(result)
41:         # --------------------------------------------------
42:         # Normalize Output
43:         # --------------------------------------------------
44:         results = []
45:         for idx, item in enumerate(predictions):
46:             results.append({
47:                 "block_id": idx + 1,
48:                 "text": item.get("text", "")
49:             })
50:         return results
