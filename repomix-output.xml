 4: from .file_manager import FileManager
 5: from .csv_manager import CSVManager
 6: class AnnotationPipeline:
 7:     def __init__(self):
 8:         self.client = MistralOCR()
 9:         self.files = FileManager()
10:         self.csv = CSVManager()
11:     def run(self):
12:         batch = self.files.get_next_batch()
13:         if len(batch) == 0:
14:             print("\nNo images left to process.")
15:             return
16:         print("=" * 60)
17:         print(f"Found {len(batch)} images to annotate.")
18:         print("=" * 60)
19:         success = 0
20:         failed = 0
21:         start_time = time.time()
22:         try:
23:             for image in tqdm(batch):
24:                 try:
25:                     text = self.client.ocr_image(str(image))
26:                     self.csv.append(
27:                         image.name,
28:                         text
29:                     )
30:                     self.files.create_preview(
31:                         image,
32:                         text
33:                     )
34:                     self.files.move_completed(image)
35:                     success += 1
36:                 except Exception as e:
37:                     failed += 1
38:                     print(f"\nFailed : {image.name}")
39:                     print(e)
40:             elapsed = time.time() - start_time
41:             print("\n")
42:             print("=" * 60)
43:             print("Annotation Complete")
44:             print("=" * 60)
45:             print(f"Successful : {success}")
46:             print(f"Failed     : {failed}")
47:             print(f"Time Taken : {elapsed:.2f} sec")
48:             print(
49:                 f"Remaining  : {self.files.remaining_images()}"
50:             )
51:             print("=" * 60)
52:         finally:
