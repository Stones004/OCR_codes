 1: from pathlib import Path
 2: import shutil
 3: ROOT_DIR = Path("outputs")
 4: DEST_DIR = ROOT_DIR / "all_roi_images"
 5: DEST_DIR.mkdir(exist_ok=True)
 6: IMAGE_EXTS = {".png", ".jpg", ".jpeg", ".bmp", ".tif", ".tiff"}
 7: count = 0
 8: for doc_folder in sorted(ROOT_DIR.glob("Doc*")):
 9:     if not doc_folder.is_dir():
10:         continue
11:     roi_folder = doc_folder / "roi"
12:     if not roi_folder.exists():
13:         continue
14:     for img_path in roi_folder.iterdir():
15:         if img_path.suffix.lower() not in IMAGE_EXTS:
16:             continue
17:         new_name = f"{doc_folder.name}_{img_path.name}"
18:         shutil.copy2(
19:             img_path,
20:             DEST_DIR / new_name
21:         )
22:         count += 1
23: print(f"\nCopied {count} ROI images to:")
24: print(DEST_DIR)
