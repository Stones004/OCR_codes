<file path="src/vertical_extractor.py">
 1: import cv2
 2: import numpy as np
 3: """
 4: Vertical Line Extractor
 5: Extracts prominent vertical structures from a scanned page using
 6: thresholding and morphological operations. The extracted image is
 7: used to locate the table separator.
 8: """
 9: class VerticalExtractor:
10:     def __init__(self,
11:                  threshold=180,
12:                  kernel_height=120):
13:         self.threshold = threshold
14:         self.kernel_height = kernel_height
15:     def extract(self, image):
16:         debug = {}
17:         # --------------------------------------------------
18:         # 1. Convert to grayscale
19:         # --------------------------------------------------
20:         gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
21:         debug["gray"] = gray
22:         # --------------------------------------------------
23:         # 2. Binary Inverse
24:         #
25:         # Background -> Black
26:         # Ink/Lines -> White
27:         # --------------------------------------------------
28:         _, binary = cv2.threshold(
29:             gray,
30:             self.threshold,
31:             255,
32:             cv2.THRESH_BINARY_INV
33:         )
34:         debug["binary"] = binary
35:         # --------------------------------------------------
36:         # 3. Extract Vertical Structures
37:         # --------------------------------------------------
38:         height, width = image.shape[:2]
39:         kernel_height = max(80, height // 25)
40:         kernel = cv2.getStructuringElement(
41:             cv2.MORPH_RECT,
42:             (1, kernel_height)
43:         )
44:         # Repair broken lines
45:         repair_kernel = cv2.getStructuringElement(
46:             cv2.MORPH_RECT,
47:             (3, 15)
48:         )
49:         binary = cv2.morphologyEx(
50:             binary,
51:             cv2.MORPH_CLOSE,
52:             repair_kernel
53:         )
54:         # Now isolate vertical objects
55:         '''vertical_kernel = cv2.getStructuringElement(
56:             cv2.MORPH_RECT,
57:             (1, 120)
58:         )'''
59:         vertical_kernel = cv2.getStructuringElement(
60:             cv2.MORPH_RECT,
61:             (1, kernel_height)
62:         )
63:         vertical = cv2.morphologyEx(
64:             binary,
65:             cv2.MORPH_OPEN,
66:             vertical_kernel
67:         )
68:         debug["vertical"] = vertical
69:         print("Inside VerticalExtractor")
70:         print(vertical.shape)
71:         print(vertical.dtype)
72:         print(np.unique(vertical))
73:         return vertical, debug
