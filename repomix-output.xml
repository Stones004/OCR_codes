18:             api_key="lm-studio",
19:         )
20:         self.preprocessor = LMStudioPreprocessor()
21:         self.prompt = """
22: Extract all visible text from the image as individual items (words, numbers, or short labels).
23: Output Requirements:
24: Return ONLY a raw JSON array (no markdown fences, no extra text).
25: Order items from top-to-bottom, then left-to-right.
26: Use normalized coordinates between 0.0 and 1.0 (top-left is 0.0, 0.0, bottom-right is 1.0, 1.0), rounded to 3 decimal places.
27: [
28:   {
29:     "text": "detected text",
30:     "bounding_box": {
31:       "left": 0.000,
32:       "top": 0.000,
33:       "right": 0.000,
34:       "bottom": 0.000
35:     },
36:     "center": {
37:       "x": 0.000,
38:       "y": 0.000
39:     }
40:   }
41: ] Return exactly ONE JSON array
42: """
43:     def read(self, image, preprocess=True):
44:         if preprocess:
45:             image = self.preprocessor.process(image)
46:         cv2.imwrite(
47:             "lmstudio_processed/lmstudio_input.png",
48:             image
49:         )
50:         success, buffer = cv2.imencode(".png", image)
51:         if not success:
52:             raise RuntimeError("Failed to encode image.")
53:         image_b64 = base64.b64encode(buffer).decode()
54:         response = self.client.chat.completions.create(
55:             model=self.model,
56:             temperature=0,
57:             messages=[
58:                 {
59:                     "role": "user",
60:                     "content": [
61:                         {
62:                             "type": "text",
63:                             "text": self.prompt,
64:                         },
65:                         {
