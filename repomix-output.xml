 5: from transformers import TrOCRProcessor
 6: from transformers import VisionEncoderDecoderModel
 7: # pyrefly: ignore [missing-import]
 8: import torch
 9: import cv2
10: from PIL import Image
11: import numpy as np
12: from .base import OCRBackend
13: """
14: OCR Engine
15: Recognizes handwritten text from annotation ROIs using Microsoft's
16: TrOCR handwriting recognition model and returns the predicted text
17: along with confidence information.
18: """
19: class TrOCRBackend(OCRBackend):
20:     def __init__(self):
21:         self.device = (
22:             "cuda"
23:             if torch.cuda.is_available()
24:             else "cpu"
25:         )
26:         self.processor = TrOCRProcessor.from_pretrained(
27:             "microsoft/trocr-base-handwritten"
28:         )
29:         self.model = VisionEncoderDecoderModel.from_pretrained(
30:             "microsoft/trocr-base-handwritten"
31:         ).to(self.device)
32:         self.model.eval()
33:     # -------------------------------------------------
34:     @torch.no_grad()
35:     def read(self, image):
36:         if isinstance(image, str):
37:             image = cv2.imread(image)
38:         if len(image.shape) == 2:
39:             image = cv2.cvtColor(
40:                 image,
41:                 cv2.COLOR_GRAY2RGB
42:             )
43:         else:
44:             image = cv2.cvtColor(
45:                 image,
46:                 cv2.COLOR_BGR2RGB
47:             )
48:         pil = Image.fromarray(image)
49:         pixel_values = self.processor(
50:             images=pil,
51:             return_tensors="pt"
52:         ).pixel_values.to(self.device)
53:         generated_ids = self.model.generate(
54:             pixel_values,
55:             max_new_tokens=64
56:         )
57:         text = self.processor.batch_decode(
58:             generated_ids,
59:             skip_special_tokens=True
60:         )[0]
61:         return {
62:             "text": text.strip(),
63:             "confidence": 1.0,
64:             "words": []
65:         }
