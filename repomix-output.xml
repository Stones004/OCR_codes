<file path="roi_consolidator.py">
 1: from pathlib import Path
 2: import shutil
 3: # Root directory containing Doc**** folders
 4: ROOT_DIR = Path("outputs")
 5: # Destination folder
 6: DEST_DIR = ROOT_DIR / "all_roi_images"
 7: DEST_DIR.mkdir(exist_ok=True)
 8: # Supported image extensions
 9: IMAGE_EXTS = {".png", ".jpg", ".jpeg", ".bmp", ".tif", ".tiff"}
10: count = 0
11: # Iterate through every Doc**** folder
12: for doc_folder in sorted(ROOT_DIR.glob("Doc*")):
13:     if not doc_folder.is_dir():
14:         continue
15:     roi_folder = doc_folder / "roi"
16:     if not roi_folder.exists():
17:         continue
18:     # Copy every image in roi
19:     for img_path in roi_folder.iterdir():
20:         if img_path.suffix.lower() not in IMAGE_EXTS:
21:             continue
22:         # Prefix filename with document name to avoid collisions
23:         new_name = f"{doc_folder.name}_{img_path.name}"
24:         shutil.copy2(
25:             img_path,
26:             DEST_DIR / new_name
27:         )
28:         count += 1
29: print(f"\nCopied {count} ROI images to:")
30: print(DEST_DIR)
