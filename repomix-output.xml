import cv2
class Cropper:
    def __init__(self, right_padding=15):
        self.right_padding = right_padding
    def crop(self, image, separator):
        if separator is None:
            return None
        x = separator["x"] + self.right_padding
        x = min(x, image.shape[1])
        cropped = image[:, :x]
        return cropped
