  1: import cv2
  2: import numpy as np
  3: class AnnotationDetector:
  4:     def __init__(
  5:         self,
  6:         min_width=6,
  7:         min_height=6,
  8:         padding=10,
  9:         merge_dist=25,
 10:         min_confident_area=800,
 11:         min_confident_dim=20,
 12:         min_ink_pixels=150,
 13:         min_fill_ratio=0.08,
 14:     ):
 15:         self.min_width = min_width
 16:         self.min_height = min_height
 17:         self.padding = padding
 18:         self.merge_dist = merge_dist
 19:         self.min_confident_area = min_confident_area
 20:         self.min_confident_dim = min_confident_dim
 21:         self.min_ink_pixels = min_ink_pixels
 22:         self.min_fill_ratio = min_fill_ratio
 23:         self.refine_height = 140
 24:         self.valley_threshold = 0.15
 25:         self.min_valley_width = 5
 26:         self.min_segment_height = 20
 27:     def _horizontal_projection(self, roi):
 28:         return np.count_nonzero(
 29:             roi,
 30:             axis=1
 31:         )
 32:     def _smooth_projection(self, proj):
 33:         kernel = np.ones(5) / 5
 34:         return np.convolve(
 35:             proj,
 36:             kernel,
 37:             mode="same"
 38:         )
 39:     def _find_split_rows(
 40:         self,
 41:         projection
 42:     ):
 43:         threshold = 0.15 * projection.max()
 44:         valleys = []
 45:         start = None
 46:         for i, v in enumerate(projection):
 47:             if v < threshold:
 48:                 if start is None:
 49:                     start = i
 50:             else:
 51:                 if start is not None:
 52:                     if i - start >= 4:
 53:                         valleys.append(
 54:                             (start + i)//2
 55:                         )
 56:                     start = None
 57:         return valleys
 58:     def _refine_rois(self, merged, binary):
 59:         refined = []
 60:         for (x1, y1, x2, y2) in merged:
 61:             roi_h = y2 - y1
 62:             if roi_h < self.refine_height:
 63:                 refined.append((x1, y1, x2, y2))
 64:                 continue
 65:             roi = binary[y1:y2, x1:x2]
 66:             projection = np.count_nonzero(roi, axis=1).astype(np.float32)
 67:             projection = cv2.GaussianBlur(
 68:                 projection.reshape(-1, 1),
 69:                 (1, 9),
 70:                 0
 71:             ).flatten()
 72:             threshold = projection.max() * self.valley_threshold
 73:             valleys = []
 74:             start = None
 75:             for i, value in enumerate(projection):
 76:                 if value < threshold:
 77:                     if start is None:
 78:                         start = i
 79:                 else:
 80:                     if start is not None:
 81:                         if (i - start) >= self.min_valley_width:
 82:                             valleys.append((start + i) // 2)
 83:                         start = None
 84:             if len(valleys) == 0:
 85:                 refined.append((x1, y1, x2, y2))
 86:                 continue
 87:             prev = 0
 88:             pieces = []
 89:             for split in valleys:
 90:                 if split - prev >= self.min_segment_height:
 91:                     pieces.append(
 92:                         (
 93:                             x1,
 94:                             y1 + prev,
 95:                             x2,
 96:                             y1 + split
 97:                         )
 98:                     )
 99:                 prev = split
100:             if roi_h - prev >= self.min_segment_height:
101:                 pieces.append(
102:                     (
103:                         x1,
104:                         y1 + prev,
105:                         x2,
106:                         y2
107:                     )
108:                 )
109:             if len(pieces) <= 1:
110:                 refined.append((x1, y1, x2, y2))
111:             else:
112:                 refined.extend(pieces)
113:         return refined
114:     def remove_lines(self, binary):
115:         h, w = binary.shape
116:         horiz_kernel = cv2.getStructuringElement(
117:             cv2.MORPH_RECT,
118:             (max(20, w // 15), 1)
119:         )
120:         vert_kernel = cv2.getStructuringElement(
121:             cv2.MORPH_RECT,
122:             (1, max(20, h // 15))
123:         )
124:         horiz_lines = cv2.morphologyEx(
125:             binary,
126:             cv2.MORPH_OPEN,
127:             horiz_kernel
128:         )
129:         vert_lines = cv2.morphologyEx(
130:             binary,
131:             cv2.MORPH_OPEN,
132:             vert_kernel
133:         )
134:         lines = cv2.bitwise_or(
135:             horiz_lines,
136:             vert_lines
137:         )
138:         lines = cv2.dilate(
139:             lines,
140:             np.ones((3, 3), np.uint8),
141:             iterations=1
142:         )
143:         return cv2.bitwise_and(
144:             binary,
145:             cv2.bitwise_not(lines)
146:         )
147:     def _boxes_close(self, a, b):
148:         ax1, ay1, ax2, ay2 = a
149:         bx1, by1, bx2, by2 = b
150:         ax1 -= self.merge_dist
151:         ay1 -= self.merge_dist
152:         ax2 += self.merge_dist
153:         ay2 += self.merge_dist
154:         return not (
155:             bx2 < ax1 or
156:             bx1 > ax2 or
157:             by2 < ay1 or
158:             by1 > ay2
159:         )
160:     def _merge_boxes(self, boxes):
161:         changed = True
162:         while changed:
163:             changed = False
164:             merged = []
165:             used = [False] * len(boxes)
166:             for i in range(len(boxes)):
167:                 if used[i]:
168:                     continue
169:                 current = list(boxes[i])
170:                 used[i] = True
171:                 for j in range(i + 1, len(boxes)):
172:                     if used[j]:
173:                         continue
174:                     if self._boxes_close(
175:                         tuple(current),
176:                         boxes[j]
177:                     ):
178:                         current[0] = min(current[0], boxes[j][0])
179:                         current[1] = min(current[1], boxes[j][1])
180:                         current[2] = max(current[2], boxes[j][2])
181:                         current[3] = max(current[3], boxes[j][3])
182:                         used[j] = True
183:                         changed = True
184:                 merged.append(tuple(current))
185:             boxes = merged
186:         return boxes
187:     def detect(
188:         self,
189:         gray,
190:         binary
191:     ):
192:         binary = self.remove_lines(binary)
193:         num_labels, labels, stats, _ = cv2.connectedComponentsWithStats(
194:             binary,
195:             connectivity=8
196:         )
197:         boxes = []
198:         for i in range(1, num_labels):
199:             x = stats[i, cv2.CC_STAT_LEFT]
200:             y = stats[i, cv2.CC_STAT_TOP]
201:             w = stats[i, cv2.CC_STAT_WIDTH]
202:             h = stats[i, cv2.CC_STAT_HEIGHT]
203:             if w < self.min_width:
204:                 continue
205:             if h < self.min_height:
206:                 continue
207:             boxes.append(
208:                 (
209:                     x,
210:                     y,
211:                     x + w,
212:                     y + h
213:                 )
214:             )
215:         merged = self._merge_boxes(boxes)
216:         merged = self._refine_rois(
217:             merged,
218:             binary
219:         )
220:         confident = []
221:         for x1, y1, x2, y2 in merged:
222:             w = x2 - x1
223:             h = y2 - y1
224:             bbox_area = w * h
225:             if bbox_area < self.min_confident_area:
226:                 continue
227:             if w < self.min_confident_dim:
228:                 continue
229:             if h < self.min_confident_dim:
230:                 continue
231:             ink_pixels = cv2.countNonZero(
232:                 binary[y1:y2, x1:x2]
233:             )
234:             fill_ratio = ink_pixels / float(bbox_area)
235:             if ink_pixels < self.min_ink_pixels:
236:                 continue
237:             if fill_ratio < self.min_fill_ratio:
238:                 continue
239:             confident.append(
240:                 (
241:                     x1,
242:                     y1,
243:                     x2,
244:                     y2
245:                 )
246:             )
247:         detected = cv2.cvtColor(
248:             gray,
249:             cv2.COLOR_GRAY2BGR
250:         )
251:         rois = []
252:         for x1, y1, x2, y2 in confident:
253:             x1 = max(0, x1 - self.padding)
254:             y1 = max(0, y1 - self.padding)
255:             x2 = min(gray.shape[1], x2 + self.padding)
256:             y2 = min(gray.shape[0], y2 + self.padding)
257:             roi = gray[
258:                 y1:y2,
259:                 x1:x2
260:             ]
261:             rois.append(
262:                 {
263:                     "bbox": (
264:                         x1,
265:                         y1,
266:                         x2,
267:                         y2
268:                     ),
269:                     "roi": roi
270:                 }
271:             )
272:             cv2.rectangle(
273:                 detected,
274:                 (x1, y1),
275:                 (x2, y2),
276:                 (0, 0, 255),
277:                 2
278:             )
279:         return rois, {
280:             "binary": binary,
281:             "detected": detected
282:         }
