<file path="src/deskewer.py">
 1: import cv2
 2: import numpy as np
 3: class Deskewer:
 4:     def __init__(
 5:         self,
 6:         angle_range=(-5.0, 5.0),
 7:         coarse_step=0.5,
 8:         fine_step=0.05
 9:     ):
10:         self.angle_range = angle_range
11:         self.coarse_step = coarse_step
12:         self.fine_step = fine_step
13:     @staticmethod
14:     def projection_score(binary):
15:         projection = np.sum(binary == 255, axis=1)
16:         return np.var(projection)
17:     @staticmethod
18:     def rotate(image, angle):
19:         h, w = image.shape[:2]
20:         center = (w // 2, h // 2)
21:         M = cv2.getRotationMatrix2D(
22:             center,
23:             angle,
24:             1.0
25:         )
26:         rotated = cv2.warpAffine(
27:             image,
28:             M,
29:             (w, h),
30:             flags=cv2.INTER_LINEAR,
31:             borderMode=cv2.BORDER_CONSTANT,
32:             borderValue=255
33:         )
34:         return rotated
35:     def find_best_angle(self, binary):
36:         best_angle = 0
37:         best_score = -1
38:         for angle in np.arange(
39:             self.angle_range[0],
40:             self.angle_range[1] + self.coarse_step,
41:             self.coarse_step
42:         ):
43:             rotated = self.rotate(binary, angle)
44:             score = self.projection_score(rotated)
45:             if score > best_score:
46:                 best_score = score
47:                 best_angle = angle
48:         fine_start = best_angle - 0.5
49:         fine_end = best_angle + 0.5
50:         best_score = -1
51:         for angle in np.arange(
52:             fine_start,
53:             fine_end + self.fine_step,
54:             self.fine_step
55:         ):
56:             rotated = self.rotate(binary, angle)
57:             score = self.projection_score(rotated)
58:             if score > best_score:
59:                 best_score = score
60:                 best_angle = angle
61:         return best_angle
62:     def process(self, image):
63:         gray = cv2.cvtColor(
64:             image,
65:             cv2.COLOR_BGR2GRAY
66:         )
67:         _, binary = cv2.threshold(
68:             gray,
69:             0,
70:             255,
71:             cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU
72:         )
73:         angle = self.find_best_angle(binary)
74:         corrected = self.rotate(image, angle)
75:         return corrected, angle
