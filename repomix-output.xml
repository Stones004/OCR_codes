<file path="src/pdf_loader.py">
 1: from pathlib import Path
 2: import fitz  # PyMuPDF
 3: import cv2
 4: import numpy as np
 5: """
 6: PDF Loader
 7: Loads scanned PDF documents using PyMuPDF and converts every page into
 8: an OpenCV image for further processing. Optionally saves the rendered
 9: pages for debugging purposes.
10: """
11: class PDFLoader:
12:     """
13:     Loads scanned PDFs and converts each page into an OpenCV image.
14:     """
15:     def __init__(
16:         self,
17:         dpi: int = 300,
18:         save_debug: bool = False,
19:         output_dir: str | None = None,
20:     ):
21:         self.dpi = dpi
22:         self.save_debug = save_debug
23:         self.output_dir = Path(output_dir) if output_dir else None
24:         if self.save_debug and self.output_dir:
25:             self.output_dir.mkdir(parents=True, exist_ok=True)
26:     def load_pdf(self, pdf_path: str):
27:         pdf_path = Path(pdf_path)
28:         if not pdf_path.exists():
29:             raise FileNotFoundError(f"{pdf_path} not found.")
30:         document = fitz.open(pdf_path)
31:         pages = []
32:         zoom = self.dpi / 72
33:         matrix = fitz.Matrix(zoom, zoom)
34:         print("=" * 60)
35:         print("Loading PDF")
36:         print("=" * 60)
37:         print(f"File : {pdf_path.name}")
38:         print(f"Pages: {len(document)}")
39:         print(f"DPI  : {self.dpi}")
40:         print("=" * 60)
41:         for page_number in range(len(document)):
42:             page = document.load_page(page_number)
43:             pix = page.get_pixmap(
44:                 matrix=matrix,
45:                 alpha=False
46:             )
47:             image = np.frombuffer(
48:                 pix.samples,
49:                 dtype=np.uint8
50:             ).reshape(
51:                 pix.height,
52:                 pix.width,
53:                 pix.n
54:             )
55:             image = cv2.cvtColor(
56:                 image,
57:                 cv2.COLOR_RGB2BGR
58:             )
59:             pages.append(image)
60:             if self.save_debug:
61:                 filename = (
62:                     self.output_dir /
63:                     f"page_{page_number+1:03d}.png"
64:                 )
65:                 cv2.imwrite(
66:                     str(filename),
67:                     image
68:                 )
69:         document.close()
70:         print(f"Successfully loaded {len(pages)} pages.")
71:         return pages
