  1: """
  2: Annotation Detector
  3: Detects handwritten annotation regions by removing printed table
  4: lines, extracting connected components, merging nearby fragments and
  5: filtering candidates based on size and ink density. Returns cropped
  6: ROIs for OCR.
  7: """
  8: import cv2
  9: import numpy as np
 10: class AnnotationDetector:
 11:     def __init__(
 12:         self,
 13:         min_width=8, #6
 14:         min_height=6, #6
 15:         padding=10, #10
 16:         merge_dist=25, #25
 17:         min_confident_area=350, #800
 18:         min_confident_dim=8, #10
 19:         min_ink_pixels=80, #150
 20:         min_fill_ratio=0.08, #0.08
 21:         row_y_tolerance=18, #18
 22:     ):
 23:         self.min_width = min_width
 24:         self.min_height = min_height
 25:         self.padding = padding
 26:         self.merge_dist = merge_dist
 27:         self.min_confident_area = min_confident_area
 28:         self.min_confident_dim = min_confident_dim
 29:         self.min_ink_pixels = min_ink_pixels
 30:         self.min_fill_ratio = min_fill_ratio
 31:         self.refine_height = 140          # Only refine tall ROIs
 32:         self.valley_threshold = 0.15      # 15% of max projection
 33:         self.min_valley_width = 5         # Consecutive empty rows
 34:         self.min_segment_height = 20      # Prevent tiny fragments
 35:         self.row_y_tolerance = row_y_tolerance
 36:     def _horizontal_projection(self, roi):
 37:         return np.count_nonzero(
 38:             roi,
 39:             axis=1
 40:         )
 41:     def _smooth_projection(self, proj):
 42:         kernel = np.ones(5) / 5
 43:         return np.convolve(
 44:             proj,
 45:             kernel,
 46:             mode="same"
 47:         )
 48:     def _find_split_rows(
 49:         self,
 50:         projection
 51:     ):
 52:         threshold = 0.15 * projection.max()
 53:         valleys = []
 54:         start = None
 55:         for i, v in enumerate(projection):
 56:             if v < threshold:
 57:                 if start is None:
 58:                     start = i
 59:             else:
 60:                 if start is not None:
 61:                     if i - start >= 4:
 62:                         valleys.append(
 63:                             (start + i)//2
 64:                         )
 65:                     start = None
 66:         return valleys
 67:     def _refine_rois(self, merged, binary):
 68:         """
 69:         Split vertically merged ROIs using horizontal projection.
 70:         Runs ONLY on unusually tall ROIs.
 71:         """
 72:         refined = []
 73:         for (x1, y1, x2, y2) in merged:
 74:             roi_h = y2 - y1
 75:             # Small ROIs are assumed correct
 76:             if roi_h < self.refine_height:
 77:                 refined.append((x1, y1, x2, y2))
 78:                 continue
 79:             roi = binary[y1:y2, x1:x2]
 80:             # Horizontal projection
 81:             projection = np.count_nonzero(roi, axis=1).astype(np.float32)
 82:             # Smooth projection
 83:             projection = cv2.GaussianBlur(
 84:                 projection.reshape(-1, 1),
 85:                 (1, 9),
 86:                 0
 87:             ).flatten()
 88:             threshold = projection.max() * self.valley_threshold
 89:             valleys = []
 90:             start = None
 91:             for i, value in enumerate(projection):
 92:                 if value < threshold:
 93:                     if start is None:
 94:                         start = i
 95:                 else:
 96:                     if start is not None:
 97:                         if (i - start) >= self.min_valley_width:
 98:                             valleys.append((start + i) // 2)
 99:                         start = None
100:             # No valid valleys
101:             if len(valleys) == 0:
102:                 refined.append((x1, y1, x2, y2))
103:                 continue
104:             prev = 0
105:             pieces = []
106:             for split in valleys:
107:                 if split - prev >= self.min_segment_height:
108:                     pieces.append(
109:                         (
110:                             x1,
111:                             y1 + prev,
112:                             x2,
113:                             y1 + split
114:                         )
115:                     )
116:                 prev = split
117:             if roi_h - prev >= self.min_segment_height:
118:                 pieces.append(
119:                     (
120:                         x1,
121:                         y1 + prev,
122:                         x2,
123:                         y2
124:                     )
125:                 )
126:             # Safety check
127:             if len(pieces) <= 1:
128:                 refined.append((x1, y1, x2, y2))
129:             else:
130:                 refined.extend(pieces)
131:         return refined
132:     # --------------------------------------------------
133:     def remove_lines(self, binary):
134:         h, w = binary.shape
135: #        horiz_kernel = cv2.getStructuringElement(
136: #            cv2.MORPH_RECT,
137: #            (max(20, w // 15), 1)
138: #        )
139: #        vert_kernel = cv2.getStructuringElement(
140: #            cv2.MORPH_RECT,
141: #            (1, max(20, h // 15))
142: #        ) 
143:         horiz_kernel = cv2.getStructuringElement(
144:             cv2.MORPH_RECT,
145:             (max(30, w // 4), 1)
146:         )
147:         vert_kernel = cv2.getStructuringElement(
148:             cv2.MORPH_RECT,
149:             (1, max(30, h // 4))
150:         )
151:         horiz_lines = cv2.morphologyEx(
152:             binary,
153:             cv2.MORPH_OPEN,
154:             horiz_kernel
155:         )
156:         vert_lines = cv2.morphologyEx(
157:             binary,
158:             cv2.MORPH_OPEN,
159:             vert_kernel
160:         )
161:         lines = cv2.bitwise_or(
162:             horiz_lines,
163:             vert_lines
164:         )
165:         lines = cv2.dilate(
166:             lines,
167:             np.ones((3, 3), np.uint8),
168:             iterations=1
169:         )
170:         return cv2.bitwise_and(
171:             binary,
172:             cv2.bitwise_not(lines)
173:         )
174:     # --------------------------------------------------
175:     def _boxes_close(self, a, b):
176:         ax1, ay1, ax2, ay2 = a
177:         bx1, by1, bx2, by2 = b
178:         ax1 -= self.merge_dist
179:         ay1 -= self.merge_dist
180:         ax2 += self.merge_dist
181:         ay2 += self.merge_dist
182:         return not (
183:             bx2 < ax1 or
184:             bx1 > ax2 or
185:             by2 < ay1 or
186:             by1 > ay2
187:         ) 
188:     """def _boxes_close(self, a, b):
189:         #Decide whether two connected components belong to the same
190:         #handwritten text instance.
191:         ax1, ay1, ax2, ay2 = a
192:         bx1, by1, bx2, by2 = b
193:         aw = ax2 - ax1
194:         ah = ay2 - ay1
195:         bw = bx2 - bx1
196:         bh = by2 - by1
197:         # ----------------------------
198:         # 1. Horizontal gap
199:         # ----------------------------
200:         if ax2 < bx1:
201:             hgap = bx1 - ax2
202:         elif bx2 < ax1:
203:             hgap = ax1 - bx2
204:         else:
205:             hgap = 0
206:         # ----------------------------
207:         # 2. Vertical overlap
208:         # ----------------------------
209:         overlap = min(ay2, by2) - max(ay1, by1)
210:         if overlap <= 0:
211:             return False
212:         overlap_ratio = overlap / float(min(ah, bh))
213:         # ----------------------------
214:         # 3. Adaptive horizontal gap
215:         # ----------------------------
216:         max_gap = max(
217:             self.merge_dist,
218:             int(0.5 * max(aw, bw))
219:         )
220:         # ----------------------------
221:         # 4. Merge decision
222:         # ----------------------------
223:         return (
224:             overlap_ratio >= 0.40 and
225:             hgap <= max_gap
226:         ) """
227:     # The above function was perfect for numbers but broke on roman numerals 
228:     # --------------------------------------------------
229:     def _merge_boxes(self, boxes):
230:         changed = True
231:         while changed:
232:             changed = False
233:             merged = []
234:             used = [False] * len(boxes)
235:             for i in range(len(boxes)):
236:                 if used[i]:
237:                     continue
238:                 current = list(boxes[i])
239:                 used[i] = True
240:                 for j in range(i + 1, len(boxes)):
241:                     if used[j]:
242:                         continue
243:                     if self._boxes_close(
244:                         tuple(current),
245:                         boxes[j]
246:                     ):
247:                         current[0] = min(current[0], boxes[j][0])
248:                         current[1] = min(current[1], boxes[j][1])
249:                         current[2] = max(current[2], boxes[j][2])
250:                         current[3] = max(current[3], boxes[j][3])
251:                         used[j] = True
252:                         changed = True
253:                 merged.append(tuple(current))
254:             boxes = merged
255:         return boxes
256:     # --------------------------------------------------
257:     def _group_boxes_by_y(self, boxes):
258:         """
259:         Group boxes that belong to the same horizontal writing row.
260:         Each box is represented as:
261:             (x1, y1, x2, y2)
262:         Boxes are grouped using their vertical center.
263:         """
264:         rows = []
265:         # Process from top to bottom
266:         boxes = sorted(
267:             boxes,
268:             key=lambda b: (b[1] + b[3]) / 2
269:         )
270:         for box in boxes:
271:             x1, y1, x2, y2 = box
272:             cy = (y1 + y2) / 2
273:             assigned = False
274:             for row in rows:
275:                 # Current average Y position of this row
276:                 row_cy = row["center_y"]
277:                 if abs(cy - row_cy) <= self.row_y_tolerance:
278:                     row["boxes"].append(box)
279:                     # Recalculate row center
280:                     centers = [
281:                         (b[1] + b[3]) / 2
282:                         for b in row["boxes"]
283:                     ]
284:                     row["center_y"] = float(
285:                         np.mean(centers)
286:                     )
287:                     assigned = True
288:                     break
289:             if not assigned:
290:                 rows.append({
291:                     "center_y": cy,
292:                     "boxes": [box]
293:                 })
294:         # ---------------------------------------------
295:         # Convert each row into one bounding box
296:         # ---------------------------------------------
297:         row_boxes = []
298:         for row in rows:
299:             boxes_in_row = row["boxes"]
300:             x1 = min(
301:                 b[0]
302:                 for b in boxes_in_row
303:             )
304:             y1 = min(
305:                 b[1]
306:                 for b in boxes_in_row
307:             )
308:             x2 = max(
309:                 b[2]
310:                 for b in boxes_in_row
311:             )
312:             y2 = max(
313:                 b[3]
314:                 for b in boxes_in_row
315:             )
316:             row_boxes.append(
317:                 (x1, y1, x2, y2)
318:             )
319:         return row_boxes
320:     def detect(
321:         self,
322:         gray,
323:         binary
324:     ):
325:         # Remove printed table lines only
326:         binary = self.remove_lines(binary)
327:         # Connected components
328:         num_labels, labels, stats, _ = cv2.connectedComponentsWithStats(
329:             binary,
330:             connectivity=8
331:         )
332:         boxes = []
333:         for i in range(1, num_labels):
334:             x = stats[i, cv2.CC_STAT_LEFT]
335:             y = stats[i, cv2.CC_STAT_TOP]
336:             w = stats[i, cv2.CC_STAT_WIDTH]
337:             h = stats[i, cv2.CC_STAT_HEIGHT]
338:             if w < self.min_width:
339:                 continue
340:             if h < self.min_height:
341:                 continue
342:             boxes.append(
343:                 (
344:                     x,
345:                     y,
346:                     x + w,
347:                     y + h
348:                 )
349:             )
350:         # Merge nearby fragments
351:         merged = self._merge_boxes(boxes)
352:         merged = self._refine_rois(
353:             merged,
354:             binary
355:         )
356:         confident = []
357:         for x1, y1, x2, y2 in merged:
358:             w = x2 - x1
359:             h = y2 - y1
360:             bbox_area = w * h
361:             ink_pixels = cv2.countNonZero(
362:                 binary[y1:y2, x1:x2]
363:             )
364:             fill_ratio = ink_pixels / float(bbox_area)
365:             print(
366:                 f"\nCandidate:"
367:                 f" bbox={w}x{h}"
368:                 f" | bbox_area={bbox_area}"
369:                 f" | ink_pixels={ink_pixels}"
370:                 f" | fill_ratio={fill_ratio:.3f}"
371:             )
372:             if bbox_area < self.min_confident_area:
373:                 print(
374:                     f"  REJECT → bbox_area "
375:                     f"{bbox_area} < {self.min_confident_area}"
376:                 )
377:                 continue
378:             if w < self.min_confident_dim:
379:                 print(
380:                     f"  REJECT → width "
381:                     f"{w} < {self.min_confident_dim}"
382:                 )
383:                 continue
384:             if h < self.min_confident_dim:
385:                 print(
386:                     f"  REJECT → height "
387:                     f"{h} < {self.min_confident_dim}"
388:                 )
389:                 continue
390:             if ink_pixels < self.min_ink_pixels:
391:                 print(
392:                     f"  REJECT → ink_pixels "
393:                     f"{ink_pixels} < {self.min_ink_pixels}"
394:                 )
395:                 continue
396:             if fill_ratio < self.min_fill_ratio:
397:                 print(
398:                     f"  REJECT → fill_ratio "
399:                     f"{fill_ratio:.3f} < {self.min_fill_ratio}"
400:                 )
401:                 continue
402:             print("  ACCEPT ✓")
403:             confident.append(
404:                 (
405:                     x1,
406:                     y1,
407:                     x2,
408:                     y2
409:                 )
410:             )
411:             confident.append(
412:                 (
413:                     x1,
414:                     y1,
415:                     x2,
416:                     y2
417:                 )
418:             )
419:         # ==================================================
420:         # GROUP CONFIDENT ROIs BY HORIZONTAL ROW
421:         # ==================================================
422:         grouped = self._group_boxes_by_y(confident)
423:         # ==================================================
424:         # FINAL ROI CREATION
425:         # ==================================================
426:         detected = cv2.cvtColor(
427:             gray,
428:             cv2.COLOR_GRAY2BGR
429:         )
430:         rois = []
431:         for x1, y1, x2, y2 in grouped:
432:             x1 = max(0, x1 - self.padding)
433:             y1 = max(0, y1 - self.padding)
434:             x2 = min(gray.shape[1], x2 + self.padding)
435:             y2 = min(gray.shape[0], y2 + self.padding)
436:             roi = gray[
437:                 y1:y2,
438:                 x1:x2
439:             ]
440:             rois.append(
441:                 {
442:                     "bbox": (
443:                         x1,
444:                         y1,
445:                         x2,
446:                         y2
447:                     ),
448:                     "roi": roi
449:                 }
450:             )
451:             cv2.rectangle(
452:                 detected,
453:                 (x1, y1),
454:                 (x2, y2),
455:                 (0, 0, 255),
456:                 2
457:             )
458:         return rois, {
459:             "binary": binary,
460:             "detected": detected
461:         }
