<file path="ocr_dataset_builder/src/mistral_client.py">
 1: import os
 2: import mimetypes
 3: import requests
 4: from dotenv import load_dotenv
 5: from .config import MODEL
 6: from .config import ENV_FILE
 7: load_dotenv(ENV_FILE)
 8: class MistralOCR:
 9:     BASE_URL = "https://api.mistral.ai"
10:     def __init__(self):
11:         self.api_key = os.getenv("MISTRAL_API_KEY")
12:         if not self.api_key:
13:             raise ValueError("MISTRAL_API_KEY not found in .env")
14:         self.headers = {
15:             "Authorization": f"Bearer {self.api_key}"
16:         }
17:     def upload_file(self, image_path):
18:         mime_type = mimetypes.guess_type(image_path)[0] or "image/png"
19:         with open(image_path, "rb") as f:
20:             files = {
21:                 "file": (
22:                     os.path.basename(image_path),
23:                     f,
24:                     mime_type,
25:                 )
26:             }
27:             data = {
28:                 "purpose": "ocr"
29:             }
30:             response = requests.post(
31:                 f"{self.BASE_URL}/v1/files",
32:                 headers=self.headers,
33:                 files=files,
34:                 data=data,
35:             )
36:         response.raise_for_status()
37:         return response.json()["id"]
38:     def get_signed_url(self, file_id):
39:         response = requests.get(
40:             f"{self.BASE_URL}/v1/files/{file_id}/url",
41:             headers=self.headers,
42:         )
43:         response.raise_for_status()
44:         return response.json()["url"]
45:     def run_ocr(self, signed_url):
46:         headers = self.headers.copy()
47:         headers["Content-Type"] = "application/json"
48:         payload = {
49:             "model": MODEL,
50:             "document": {
51:                 "type": "document_url",
52:                 "document_url": signed_url,
53:             },
54:         }
55:         response = requests.post(
56:             f"{self.BASE_URL}/v1/ocr",
57:             headers=headers,
58:             json=payload,
59:         )
60:         response.raise_for_status()
61:         return response.json()
62:     def extract_text(self, result):
63:         pages = []
64:         for page in result["pages"]:
65:             pages.append(page["markdown"])
66:         return "\n".join(pages).strip()
67:     def ocr_image(self, image_path):
68:         file_id = self.upload_file(image_path)
69:         signed_url = self.get_signed_url(file_id)
70:         result = self.run_ocr(signed_url)
71:         return self.extract_text(result)
</file>

