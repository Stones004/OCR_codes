 1: import shutil
 2: from pathlib import Path
 3: from PIL import Image
 4: from PIL import ImageDraw
 5: from PIL import ImageFont
 6: import textwrap
 7: from .config import (
 8:     IMAGE_FOLDER,
 9:     COMPLETED_FOLDER,
10:     PREVIEW_FOLDER,
11:     IMAGE_EXTENSIONS,
