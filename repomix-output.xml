 28:     image_b64 = base64.b64encode(f.read()).decode()
 29: # ============================
 30: # OCR Prompt
 31: # ============================
 32: prompt = """
 33: You are a precise OCR engine.
 34: Your task is to detect every visible text element and localize it accurately.
 35: IMPORTANT
 36: - Measure coordinates from the ORIGINAL image.
 37: - Ignore any internal resizing.
 38: - Coordinates must be normalized to the ORIGINAL image.
 39: - Left edge = 0
 40: - Right edge = 1
 41: - Top edge = 0
 42: - Bottom edge = 1
 43: Every coordinate must correspond to the actual visible location of the text in the image.
 44: Do not estimate.
 45: If the exact position is uncertain, inspect the image again before returning coordinates.
 46: For every text:
 47: 1. Find the tightest possible bounding rectangle.
 48: 2. Return the normalized bounding box.
 49: 3. Compute the center of that box.
 50: Return ONLY valid JSON.
 51: [
 52:     {
 53:         "text":"...",
 54:         "bounding_box":{
 55:             "left":0.000,
 56:             "top":0.000,
 57:             "right":0.000,
 58:             "bottom":0.000
 59:         },
 60:         "center":{
 61:             "x":0.000,
 62:             "y":0.000
 63:         }
 64:     }
 65: ]
 66: """
 67: # ============================
 68: # Run OCR
 69: # ============================
 70: response = client.chat.completions.create(
 71:     model=MODEL,
 72:     temperature=0,
 73:     messages=[
 74:         {
 75:             "role": "user",
 76:             "content": [
 77:                 {
 78:                     "type": "text",
 79:                     "text": prompt,
 80:                 },
 81:                 {
 82:                     "type": "image_url",
 83:                     "image_url": {
 84:                         "url": f"data:image/png;base64,{image_b64}"
 85:                     },
 86:                 },
 87:             ],
 88:         }
 89:     ],
