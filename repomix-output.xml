  1: import cv2
  2: import numpy as np
  3: class LineDetector:
  4:     def __init__(
  5:         self,
  6:         left_ratio=0.05,
  7:         right_ratio=0.50,
  8:         expected_x=None,
  9:         tolerance=None
 10:     ):
 11:         self.left_ratio = left_ratio
 12:         self.right_ratio = right_ratio
 13:         self.expected_x = expected_x
 14:         self.tolerance = tolerance
 15:     def detect(self, vertical):
 16:         num_labels, labels, stats, centroids = cv2.connectedComponentsWithStats(
 17:             vertical,
 18:             connectivity=8
 19:         )
 20:         h, w = vertical.shape
 21:         LEFT_LIMIT = int(w * self.left_ratio)
 22:         RIGHT_LIMIT = int(w * self.right_ratio)
 23:         output = cv2.cvtColor(vertical, cv2.COLOR_GRAY2BGR)
 24:         candidates = []
 25:         for i in range(1, num_labels):
 26:             x = stats[i, cv2.CC_STAT_LEFT]
 27:             y = stats[i, cv2.CC_STAT_TOP]
 28:             width = stats[i, cv2.CC_STAT_WIDTH]
 29:             height = stats[i, cv2.CC_STAT_HEIGHT]
 30:             area = stats[i, cv2.CC_STAT_AREA]
 31:             reason = None
 32:             if height < h * 0.50:
 33:                 reason = f"Too short ({height}px)"
 34:             elif ( height / width) < 40:
 35:                 reason = f"Poor aspect ratio ({(height / width):.1f})"
 36:             elif x < LEFT_LIMIT:
 37:                 reason = f"Too close to left border (x={x})"
 38:             elif x > RIGHT_LIMIT:
 39:                 reason = f"Outside left half (x={x})"
 40:             if reason is not None:
 41:                 print(
 42:                     f"Rejected Component {i} | "
 43:                     f"x={x}, y={y}, w={width}, h={height} | "
 44:                     f"Reason: {reason}"
 45:                 )
 46:                 continue
 47:             component_mask = np.zeros_like(vertical)
 48:             component_mask[labels == i] = 255
 49:             points = np.column_stack(np.where(component_mask > 0))
 50:             candidate = {
 51:                 "x": x,
 52:                 "y": y,
 53:                 "w": width,
 54:                 "h": height,
 55:                 "area": area,
 56:                 "mask": component_mask,
 57:                 "points": points
 58:             }
 59:             candidates.append(candidate)
 60:             cv2.rectangle(
 61:                 output,
 62:                 (x, y),
 63:                 (x + width, y + height),
 64:                 (0, 255, 0),
 65:                 2
 66:             )
 67:             print("\nValid Candidates")
 68:             for c in candidates:
 69:                 print(
 70:                     f"x={c['x']}, "
 71:                     f"h={c['h']}, "
 72:                     f"w={c['w']}, "
 73:                     f"area={c['area']}"
 74:                 )
 75:         # ------------------------------------------------
 76:         # No candidates
 77:         # ------------------------------------------------
 78:         if len(candidates) == 0:
 79:             return output, None
 80:         # ------------------------------------------------
 81:         # If we know approximately where the separator is,
 82:         # choose the closest candidate.
 83:         # ------------------------------------------------
 84:         if self.expected_x is not None:
 85:             if self.tolerance is not None:
 86:                 filtered = []
 87:                 for c in candidates:
 88:                     if abs(c["x"] - self.expected_x) <= self.tolerance:
 89:                         filtered.append(c)
 90:                 if len(filtered) > 0:
 91:                     candidates = filtered
 92:             best = min(
 93:                 candidates,
 94:                 key=lambda c: abs(c["x"] - self.expected_x)
 95:             )
 96:         else:
 97:             best = min(
 98:                 candidates,
 99:                 key=lambda c: c["x"]
100:             )
101:         cv2.rectangle(
102:             output,
103:             (best["x"], best["y"]),
104:             (best["x"] + best["w"], best["y"] + best["h"]),
105:             (0, 0, 255),
106:             4
107:         )
108:         print("\nSelected Candidate")
109:         print(best)
110:         return output, best
