<file path="src/lmstudio_preprocessor.py">
 1: """
 2: LM Studio Preprocessor
 3: Applies light image enhancement before sending the cropped annotation
 4: strip to the vision-language OCR model.
 5: """
 6: import cv2
 7: import numpy as np
 8: class LMStudioPreprocessor:
 9:     def __init__(self):
10:         # Sharpening kernel
11:         self.kernel = np.array([
12:             [0, -1, 0],
13:             [-1, 5, -1],
14:             [0, -1, 0]
15:         ], dtype=np.float32)
16:     # --------------------------------------------------
17:     def process(self, image):
18:         # Already grayscale
19:         if len(image.shape) == 2:
20:             gray = image.copy()
21:         # Colour image
22:         else:
23:             gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
24:         # Remove scanner noise while preserving handwriting
25:         denoised = cv2.fastNlMeansDenoising(
26:             gray,
27:             None,
28:             h=10,
29:             templateWindowSize=7,
30:             searchWindowSize=21
31:         )
32:         # Sharpen handwriting
33:         sharpened = cv2.filter2D(
34:             denoised,
35:             -1,
36:             self.kernel
37:         )
38:         return sharpened
