20:             raise FileNotFoundError(f"{pdf_path} not found.")
21:         document = fitz.open(pdf_path)
22:         pages = []
23:         zoom = self.dpi / 72
24:         matrix = fitz.Matrix(zoom, zoom)
25:         print("=" * 60)
26:         print("Loading PDF")
27:         print("=" * 60)
28:         print(f"File : {pdf_path.name}")
29:         print(f"Pages: {len(document)}")
30:         print(f"DPI  : {self.dpi}")
31:         print("=" * 60)
32:         for page_number in range(len(document)):
33:             page = document.load_page(page_number)
34:             pix = page.get_pixmap(
35:                 matrix=matrix,
36:                 alpha=False
37:             )
38:             image = np.frombuffer(
39:                 pix.samples,
40:                 dtype=np.uint8
41:             ).reshape(
42:                 pix.height,
43:                 pix.width,
44:                 pix.n
45:             )
46:             image = cv2.cvtColor(
47:                 image,
48:                 cv2.COLOR_RGB2BGR
49:             )
50:             pages.append(image)
51:             if self.save_debug:
52:                 filename = (
