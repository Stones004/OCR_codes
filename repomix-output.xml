14: class LMStudioBackend(OCRBackend):
15:     def __init__(
16:         self,
17:         #model="google/gemma-3-12b",
18:         model="mistralai/ministral-3-3b",
19:         host="http://127.0.0.1:1234/v1",
20:     ):
21:         self.model = model
22:         self.client = OpenAI(
23:             base_url=host,
24:             api_key="lm-studio",
25:         )
26:         self.preprocessor = LMStudioPreprocessor()
27:         self.prompt = """
28: Extract all visible text from the image as individual items (words, numbers, or short labels).
29: Output Requirements:
30: Return ONLY a raw JSON array (no markdown fences, no extra text).
31: Order items from top-to-bottom, then left-to-right.
32: Use normalized coordinates between 0.0 and 1.0 (top-left is 0.0, 0.0, bottom-right is 1.0, 1.0), rounded to 3 decimal places.
33: [
34:   {
35:     "text": "detected text",
36:     "bounding_box": {
37:       "left": 0.000,
38:       "top": 0.000,
39:       "right": 0.000,
40:       "bottom": 0.000
41:     },
42:     "center": {
43:       "x": 0.000,
44:       "y": 0.000
45:     }
46:   }
47: ] Return exactly ONE JSON array
48: """
49:     # --------------------------------------------------
50:     def read(self, image, preprocess=True):
51:         # Production uses this.
52:         # Research benchmarking disables it.
53:         if preprocess:
54:             image = self.preprocessor.process(image)
55:         cv2.imwrite(
56:             "lmstudio_processed/lmstudio_input.png",
57:             image
58:         )
59:         success, buffer = cv2.imencode(".png", image)
60:         if not success:
61:             raise RuntimeError("Failed to encode image.")
62:         image_b64 = base64.b64encode(buffer).decode()
63:         response = self.client.chat.completions.create(
64:             model=self.model,
65:             temperature=0,
66:             messages=[
67:                 {
68:                     "role": "user",
69:                     "content": [
70:                         {
71:                             "type": "text",
72:                             "text": self.prompt,
73:                         },
74:                         {
75:                             "type": "image_url",
76:                             "image_url": {
77:                                 "url": f"data:image/png;base64,{image_b64}"
78:                             },
79:                         },
80:                     ],
81:                 }
82:             ],
83:         )
84:         content = response.choices[0].message.content
85:         # Find where the first JSON array starts
86:         start = content.find("[")
87:         if start == -1:
88:             raise RuntimeError(
89:                 f"No JSON array found.\n\nResponse:\n{content}"
90:             )
91:         decoder = json.JSONDecoder()
92:         try:
93:             predictions, end = decoder.raw_decode(content[start:])
94:             return predictions
95:         except json.JSONDecodeError as e:
96:             print("\n========== INVALID JSON ==========\n")
97:             print(content)
98:             print("\n==================================\n")
99:             raise
