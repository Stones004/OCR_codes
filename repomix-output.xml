139:     pdfs = sorted(INPUT_DIR.glob("*.pdf"))
140:     if len(pdfs) == 0:
141:         print("No PDFs found.")
142:         return
143:     print(f"\nFound {len(pdfs)} PDF(s)\n")
144:     for pdf in tqdm(pdfs):
145:         process_pdf(pdf)
146:     print("\n===================================")
147:     print("ROI DATASET CREATION COMPLETE")
148:     print("===================================")
149:     print(f"Saved to : {OUTPUT_DIR.resolve()}")
