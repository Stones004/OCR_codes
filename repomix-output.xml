158:         )
159:         x2, y2 = convert_point(
160:             bbox["right"],
161:             bbox["bottom"],
162:         )
163:         # Slight padding
164:         x1 -= PADDING
165:         y1 -= PADDING
166:         x2 += PADDING
167:         y2 += PADDING
168:         draw.rectangle(
169:             [(x1, y1), (x2, y2)],
170:             outline="red",
171:             width=2,
172:         )
173:         draw.text(
174:             (x1, max(0, y1 - 18)),
