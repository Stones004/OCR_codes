<file path="research/prepare_roi_dataset.py">
  1: """
  2: prepare_roi_dataset.py
  3: Creates a dataset of cropped left-margin ROIs from scanned PDFs.
  4: Pipeline
  5: PDF
  6:  ↓
  7: Render Page
  8:  ↓
  9: Deskew
 10:  ↓
 11: Preprocess
 12:  ↓
 13: Vertical Extraction
 14:  ↓
 15: Line Detection
 16:  ↓
 17: Crop ROI
 18:  ↓
 19: Save ROI
 20: Output
 21: data/
 22:     roi_dataset/
 23:         Paper1_page_001.png
 24:         Paper1_page_002.png
 25:         ...
 26: """
 27: from pathlib import Path
 28: import cv2
 29: import fitz
 30: import numpy as np
 31: from tqdm import tqdm
 32: from src.deskewer import Deskewer
 33: from src.vertical_extractor import VerticalExtractor
 34: from src.line_detector import LineDetector
 35: from src.cropper import Cropper
 36: from src.annotation_detector import AnnotationDetector
 37: # ============================================================
 38: # Configuration
 39: # ============================================================
 40: INPUT_DIR = Path("data/input_pdfs")
 41: OUTPUT_DIR = Path("data/roi_dataset")
 42: OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
 43: DPI = 300
 44: # ============================================================
 45: # PDF Renderer
 46: # ============================================================
 47: def pdf_to_images(pdf_path):
 48:     document = fitz.open(pdf_path)
 49:     zoom = DPI / 72
 50:     matrix = fitz.Matrix(zoom, zoom)
 51:     for page_number in range(len(document)):
 52:         page = document.load_page(page_number)
 53:         pix = page.get_pixmap(matrix=matrix)
 54:         image = np.frombuffer(
 55:             pix.samples,
 56:             dtype=np.uint8
 57:         ).reshape(
 58:             pix.height,
 59:             pix.width,
 60:             pix.n
 61:         )
 62:         if pix.n == 4:
 63:             image = cv2.cvtColor(
 64:                 image,
 65:                 cv2.COLOR_RGBA2BGR
 66:             )
 67:         else:
 68:             image = cv2.cvtColor(
 69:                 image,
 70:                 cv2.COLOR_RGB2BGR
 71:             )
 72:         yield page_number + 1, image
 73:     document.close()
 74: # ============================================================
 75: # Preprocessor
 76: # ============================================================
 77: class Preprocessor:
 78:     def __init__(self, kernel_size=3):
 79:         self.kernel_size = kernel_size
 80:     def full_pipeline(self, gray):
 81:         _, binary = cv2.threshold(
 82:             gray,
 83:             0,
 84:             255,
 85:             cv2.THRESH_BINARY + cv2.THRESH_OTSU
 86:         )
 87:         kernel = np.ones(
 88:             (
 89:                 self.kernel_size,
 90:                 self.kernel_size
 91:             ),
 92:             np.uint8
 93:         )
 94:         return cv2.morphologyEx(
 95:             binary,
 96:             cv2.MORPH_CLOSE,
 97:             kernel
 98:         )
 99:     def process(self, image):
100:         gray = cv2.cvtColor(
101:             image,
102:             cv2.COLOR_BGR2GRAY
103:         )
104:         return self.full_pipeline(gray)
105: # ============================================================
106: # Process One Page
107: # ============================================================
108: def process_page(image):
109:     # --------------------------------------------------------
110:     # 1. Deskew
111:     # --------------------------------------------------------
112:     deskewed, angle = deskewer.process(image)
113:     # --------------------------------------------------------
114:     # 3. Vertical Line Extraction
115:     # --------------------------------------------------------
116:     vertical, _ = vertical_extractor.extract(deskewed)
117:     # --------------------------------------------------------
118:     # 4. Separator Detection
119:     # --------------------------------------------------------
120:     _, separator = line_detector.detect(vertical)
121:     if separator is None:
122:         return []
123:     # --------------------------------------------------------
124:     # 5. Crop ROI
125:     # --------------------------------------------------------
126:     strip = cropper.crop(deskewed, separator)
127:     if strip is None:
128:         return []
129:     gray = cv2.cvtColor(
130:         strip,
131:         cv2.COLOR_BGR2GRAY
132:     )
133:     _, binary = cv2.threshold(
134:         gray,
135:         0,
136:         255,
137:         cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU
138:     )
139:     rois, _ = annotation_detector.detect(
140:         gray,
141:         binary
142:     )
143:     print(type(rois))
144:     print(len(rois))
145:     return rois
146: # ============================================================
147: # Process One PDF
148: # ============================================================
149: def process_pdf(pdf_path):
150:     pdf_name = pdf_path.stem
151:     print(f"\nProcessing {pdf_name}")
152:     saved = 0
153:     failed = 0
154:     for page_number, image in pdf_to_images(pdf_path):
155:         try:
156:             rois = process_page(image)
157:         except Exception as e:
158:             print(
159:                 f"Page {page_number:03d} failed : {e}"
160:             )
161:             failed += 1
162:             continue
163:         if len(rois) == 0:
164:             print(
165:                 f"Page {page_number:03d}: No annotations detected"
166:             )
167:             failed += 1
168:             continue
169:         for roi_number, roi in enumerate(rois, start=1):
170:             filename = (
171:                 f"{pdf_name}"
172:                 f"_page_{page_number:03d}"
173:                 f"_roi_{roi_number:03d}.png"
174:             )
175:             output_path = OUTPUT_DIR / filename
176:             cv2.imwrite(
177:                 str(output_path),
