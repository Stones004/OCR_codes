  1: import cv2
  2: import numpy as np
  3: from pathlib import Path
  4: class OCRPreprocessor:
  5:     def __init__(
  6:         self,
  7:         method="connected_components",
  8:         scale=4,
  9:         min_area=200,
 10:         bilateral_d=9,
 11:         bilateral_sigma_color=75,
 12:         bilateral_sigma_space=75,
 13:         kernel_size=2,
 14:         iterations=1,
 15:         gamma=2.0,
 16:         rolling_radius=80
 17:     ):
 18:         self.method = method.lower()
 19:         self.scale = scale
 20:         self.min_area = min_area
 21:         self.bilateral_d = bilateral_d
 22:         self.bilateral_sigma_color = bilateral_sigma_color
 23:         self.bilateral_sigma_space = bilateral_sigma_space
 24:         self.kernel_size = kernel_size
 25:         self.iterations = iterations
 26:         self.gamma_value = gamma
 27:         self.rolling_radius = rolling_radius
 28:         self.methods = {
 29:             "connected_components": self.connected_components,
 30:             "otsu": self.otsu,
 31:             "morph_close": self.morph_close,
 32:             "morph_dilate": self.morph_dilate,
 33:             "bilateral_otsu": self.bilateral_otsu,
 34:             "full_pipeline": self.full_pipeline,
 35:         }
 36:         print("\nRegistered preprocessing methods:")
 37:         for name, fn in self.methods.items():
 38:             print(f"{name:25} -> {type(fn)}")
 39:     # --------------------------------------------------
 40:     # Utilities
 41:     # --------------------------------------------------
 42:     def to_gray(self, image):
 43:         if len(image.shape) == 3:
 44:             return cv2.cvtColor(
 45:                 image,
 46:                 cv2.COLOR_BGR2GRAY
 47:             )
 48:         return image.copy()
 49:     def upscale(self, gray):
 50:         return cv2.resize(
 51:             gray,
 52:             None,
 53:             fx=self.scale,
 54:             fy=self.scale,
 55:             interpolation=cv2.INTER_CUBIC
 56:         )
 57:     def connected_components(self, gray):
 58:         _, binary = cv2.threshold(
 59:             gray,
 60:             0,
 61:             255,
 62:             cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU
 63:         )
 64:         num_labels, labels, stats, _ = cv2.connectedComponentsWithStats(
 65:             binary,
 66:             connectivity=8
 67:         )
 68:         clean = np.zeros_like(binary)
 69:         for i in range(1, num_labels):
 70:             area = stats[i, cv2.CC_STAT_AREA]
 71:             if area >= self.min_area:
 72:                 clean[labels == i] = 255
 73:         return clean
 74:     def otsu(self, gray):
 75:         denoised = cv2.fastNlMeansDenoising(
 76:             gray,
 77:             h=10
 78:         )
 79:         _, binary = cv2.threshold(
 80:             denoised,
 81:             0,
 82:             255,
 83:             cv2.THRESH_BINARY + cv2.THRESH_OTSU
 84:         )
 85:         return binary
 86:     def morph_close(self, gray):
 87:         _, binary = cv2.threshold(
 88:             gray,
 89:             0,
 90:             255,
 91:             cv2.THRESH_BINARY + cv2.THRESH_OTSU
 92:     )
 93:         kernel = np.ones(
 94:             (
 95:                 self.kernel_size,
 96:                 self.kernel_size
 97:             ),
 98:             np.uint8
 99:         )
100:         return cv2.morphologyEx(
101:             binary,
102:             cv2.MORPH_CLOSE,
103:             kernel
104:         )
105:     def morph_dilate(self, gray):
106:         _, binary = cv2.threshold(
107:             gray,
108:             0,
109:             255,
110:             cv2.THRESH_BINARY + cv2.THRESH_OTSU
111:         )
112:         kernel = np.ones(
113:             (
114:                 self.kernel_size,
115:                 self.kernel_size
116:             ),
117:             np.uint8
118:         )
119:         return cv2.dilate(
120:             binary,
121:             kernel,
122:             iterations=self.iterations
123:         )
124:     def bilateral_otsu(self, gray):
125:         _, binary = cv2.threshold(
126:             gray,
127:             0,
128:             255,
129:             cv2.THRESH_BINARY + cv2.THRESH_OTSU
130:         )
131:         return binary
132:     def full_pipeline(self, gray):
133:         _, binary = cv2.threshold(
134:             gray,
135:             0,
136:             255,
137:             cv2.THRESH_BINARY + cv2.THRESH_OTSU
138:         )
139:         kernel = np.ones(
140:             (
141:                 self.kernel_size,
142:                 self.kernel_size
143:             ),
144:             np.uint8
145:         )
146:         return cv2.morphologyEx(
147:             binary,
148:             cv2.MORPH_CLOSE,
149:             kernel
150:         )
151:     # --------------------------------------------------
152:     # Main Interface
153:     # --------------------------------------------------
154:     def process(self, image):
155:         gray = self.to_gray(image)
156:         gray = self.upscale(gray)
157:         if self.method not in self.methods:
158:             raise ValueError(
159:                 f"Unknown preprocessing method: {self.method}"
160:             )
161:         processed = self.methods[self.method](gray)
162:         return gray, processed
163:     def available_methods(self):
164:         """Return all registered preprocessing methods."""
165:         return list(self.methods.keys())
166:     def process_method(self, image, method):
167:         """
168:         Process an image using a specific preprocessing method.
169:         """
170:         if method not in self.methods:
171:             raise ValueError(f"Unknown preprocessing method: {method}")
172:         gray = self.to_gray(image)
173:         gray = self.upscale(gray)
174:         processed = self.methods[method](gray.copy())
175:         return gray, processed
176:     def benchmark(self, image):
177:         """
178:         Run every preprocessing method on the same image.
179:         """
180:         gray = self.to_gray(image)
181:         gray = self.upscale(gray)
182:         outputs = {}
183:         for method in self.available_methods():
184:             outputs[method] = self.methods[method](gray.copy())
185:         return gray, outputs
186:     def save_benchmark(self, outputs, output_dir):
187:         """
188:         Save all benchmark images.
189:         """
190:         output_dir = Path(output_dir)
191:         output_dir.mkdir(parents=True, exist_ok=True)
192:         for name, image in outputs.items():
193:             cv2.imwrite(
194:                 str(output_dir / f"{name}.png"),
195:                 image
196:             )
