<file path="research/evaluate.py">
  1: """
  2: Evaluate OCR preprocessing methods.
  3: For every image in the dataset:
  4:     Image
  5:         ↓
  6:     Every preprocessing method
  7:         ↓
  8:     OCR
  9:         ↓
 10:     Metrics
 11:         ↓
 12:     evaluation.csv
 13: """
 14: from pathlib import Path
 15: import time
 16: import cv2
 17: import pandas as pd
 18: from src.ocr_preprocessor import OCRPreprocessor
 19: from src.roi_text_extractor import ROITextExtractor
 20: # ----------------------------------------------------------
 21: # CONFIG
 22: # ----------------------------------------------------------
 23: #DATASET = Path("outputs/P1/roi")
 24: DATASET = Path("data/roi_dataset/")
 25: OUTPUT = Path("research/results/csv/evaluation.csv")
 26: BACKEND = "lmstudio"
 27: # ----------------------------------------------------------
 28: # DATASET
 29: # ----------------------------------------------------------
 30: def load_dataset(folder):
 31:     exts = {".png", ".jpg", ".jpeg", ".tif"}
 32:     return sorted(
 33:         [
 34:             f
 35:             for f in Path(folder).iterdir()
 36:             if f.suffix.lower() in exts
 37:         ]
 38:     )
 39: # ----------------------------------------------------------
 40: # MAIN
 41: # ----------------------------------------------------------
 42: def main():
 43:     preprocessor = OCRPreprocessor()
 44:     ocr = ROITextExtractor(
 45:         backend=BACKEND,
 46:         use_backend_preprocessing=False
 47:     )
 48:     results = []
 49:     images = load_dataset(DATASET)
 50:     print(f"\nFound {len(images)} image(s)\n")
 51:     for image_path in images:
 52:         print(f"Processing: {image_path.name}")
 53:         image = cv2.imread(str(image_path))
 54:         if image is None:
 55:             print("Could not load image.")
 56:             continue
 57:         for method in preprocessor.available_methods():
 58:             # --------------------------------------
 59:             # PREPROCESSING
 60:             # --------------------------------------
 61:             t0 = time.perf_counter()
 62:             _, processed = preprocessor.process_method(
 63:                 image,
 64:                 method
 65:             )
 66:             save_dir = Path("research/results/preprocessed") / method
 67:             save_dir.mkdir(parents=True, exist_ok=True)
 68:             cv2.imwrite(
 69:                 str(save_dir / image_path.name),
 70:                 processed
 71:             )
 72:             preprocess_ms = (
 73:                 time.perf_counter()
 74:                 - t0
 75:             ) * 1000
 76:             # --------------------------------------
 77:             # OCR
 78:             # --------------------------------------
 79:             t0 = time.perf_counter()
 80:             predictions = ocr.extract(processed)
 81:             ocr_ms = (
 82:                 time.perf_counter()
 83:                 - t0
 84:             ) * 1000
 85:             # --------------------------------------
 86:             # TEXT
 87:             # --------------------------------------
 88:             text = "\n".join(
 89:                 block["text"]
 90:                 for block in predictions
 91:             )
 92:             # --------------------------------------
 93:             # SAVE OCR TEXT
 94:             # --------------------------------------
 95:             ocr_dir = Path("research/results/ocr") / method
 96:             ocr_dir.mkdir(parents=True, exist_ok=True)
 97:             with open(
 98:                 ocr_dir / f"{image_path.stem}.txt",
 99:                 "w",
100:                 encoding="utf-8"
101:             ) as f:
102:                 f.write(text)
103:             # --------------------------------------
104:             # IMAGE METRICS
105:             # --------------------------------------
106:             black_pixels = (
107:                 processed.size
108:                 - cv2.countNonZero(processed)
109:             )
110:             density = black_pixels / processed.size
111:             # --------------------------------------
112:             # SAVE
113:             # --------------------------------------
114:             results.append({
115:                 "image": image_path.name,
116:                 "method": method,
117:                 "preprocess_ms": round(preprocess_ms, 2),
118:                 "ocr_ms": round(ocr_ms, 2),
119:                 "total_ms": round(
120:                     preprocess_ms + ocr_ms,
121:                     2
122:                 ),
123:                 "blocks": len(predictions),
124:                 "characters": len(text),
125:                 "words": len(text.split()),
126:                 "lines": len(text.splitlines()),
127:                 "density": round(density, 4),
128:                 "empty": len(text.strip()) == 0,
129:                 "text": text
130:             })
131:     df = pd.DataFrame(results)
132:     OUTPUT.parent.mkdir(
133:         parents=True,
134:         exist_ok=True
135:     )
136:     df.to_csv(
137:         OUTPUT,
138:         index=False
139:     )
140:     print("\nEvaluation Complete\n")
141:     print(df.head())
142:     print(f"\nSaved to:\n{OUTPUT}")
143: if __name__ == "__main__":
144:     main()
